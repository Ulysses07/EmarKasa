<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kasa.App.Core\Kasa.App.Core.csproj" />
  </ItemGroup>

  <!-- Kasa.App'in kodla yazılmış kontrolleri (ParaGirisi, DurumSeridi, CipGrubu, BosDurum) ve takip sayfası yapı taşları
       (Views/TakipUi.cs) aynı kaynak dosyalarıyla derlenip gerçek MAUI bağlama ve stil motoruyla sınanır (net10.0 kütüphanesi,
       iş yükü gerektirmez). Controls.Xaml, görünüm eşdeğerliği testlerinde Colors.xaml/Styles.xaml'i ve eski biçimlendirmeyi
       çalışma anında yükler. Sürüm Kasa.App ile aynı kaynaktan gelir: depo kökündeki Directory.Build.props $(MauiVersion). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls.Core" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Xaml" Version="$(MauiVersion)" />
    <Compile Include="..\Kasa.App\Controls\*.cs" Link="Kontroller\%(Filename)%(Extension)" />
    <Compile Include="..\Kasa.App\Views\TakipUi.cs" Link="Kontroller\TakipUi.cs" />
    <Compile Include="..\Kasa.App\Views\EkstreAktarmaPage*.cs" Link="Kontroller\%(Filename)%(Extension)" />
    <Compile Include="..\Kasa.App\Views\DosyaIslemleri.cs" Link="Kontroller\DosyaIslemleri.cs" />
  </ItemGroup>

  <!-- Kasa.App dönüştürücüleri aynı kaynak dosyalarıyla derlenip Donusturuculer/ altında sınanır (Kasa.App'e ve Windows
       iş yüküne başvuru gerekmez; CI'da Linux'ta koşar). Yeni dönüştürücü kendiliğinden derlenir; kapsam testi onu da
       ister. Dosyalar MAUI SDK'nın örtük using'lerine dayanır: yalnız kullandıkları iki ad alanı burada eklenir. -->
  <ItemGroup>
    <Compile Include="..\Kasa.App\Converters\*.cs" Link="Donusturuculer\Kaynak\%(Filename)%(Extension)" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Graphics" />
    <Using Include="Microsoft.Maui.Storage" />
    <Using Include="Microsoft.Maui.Devices" />
    <Using Include="Microsoft.Maui.ApplicationModel" />
    <Using Include="Microsoft.Maui.ApplicationModel.DataTransfer" />
  </ItemGroup>

</Project>
