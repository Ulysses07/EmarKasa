<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · AppShell — koyu yeşil flyout (tasarım handoff).
     Görünürlük/route mantığı code-behind'da: AnaMenu, AyarlarSekme, CikisTiklandi. -->
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:v="clr-namespace:Kasa.App.Views"
       x:Class="Kasa.App.AppShell"
       Title="Emar Kasa"
       FlyoutBehavior="Locked"
       FlyoutBackgroundColor="{StaticResource Sidebar}"
       FlyoutWidth="248"
       Shell.BackgroundColor="{StaticResource Card}"
       Shell.ForegroundColor="{StaticResource Ink}"
       Shell.TitleColor="{StaticResource Ink}">

    <!-- Marka başlığı -->
    <Shell.FlyoutHeader>
        <Grid Padding="18,22,18,14" ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
            <Border Grid.RowSpan="2" WidthRequest="30" HeightRequest="30" StrokeThickness="0"
                    StrokeShape="RoundRectangle 9" Background="{StaticResource BrushGreen}"
                    VerticalOptions="Center">
                <Label Text="₺" TextColor="White" FontFamily="PlexSansBold" FontSize="15"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="Emar Kasa" FontFamily="PlexSansBold" FontSize="15.5"
                   TextColor="{StaticResource SidebarTitle}" />
            <Label Grid.Column="1" Grid.Row="1" Text="KASA DEFTERİ" FontFamily="PlexSans" FontSize="10.5"
                   CharacterSpacing="1" TextColor="{StaticResource SidebarMuted}" />
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Oturumdaki kişi (paket E): "EMAR · Editör". BindingContext code-behind'da AuthViewModel. -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout x:Name="KimlikAlani" Padding="22,10,18,18" Spacing="2" IsVisible="{Binding GirisYapildi}">
            <Label Text="OTURUM" FontFamily="PlexSans" FontSize="10.5" CharacterSpacing="1"
                   TextColor="{StaticResource SidebarMuted}" />
            <Label Text="{Binding AktifKimlik}" FontFamily="PlexSansMedium" FontSize="13"
                   TextColor="{StaticResource SidebarText}" LineBreakMode="TailTruncation" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <!-- Menü öğesi şablonu: aktif sekme #33453A zemin + açık nokta -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Margin="10,2" Padding="12,0" HeightRequest="38" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="{StaticResource SidebarActive}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Background" Value="{StaticResource SidebarHover}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Ellipse WidthRequest="6" HeightRequest="6" Fill="{StaticResource SidebarAccent}"
                         VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Title}" FontFamily="PlexSansMedium" FontSize="13.5"
                       TextColor="{StaticResource SidebarText}" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>
    <Shell.MenuItemTemplate>
        <DataTemplate>
            <Grid Margin="10,2" Padding="12,0" HeightRequest="38" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Ellipse WidthRequest="6" HeightRequest="6" Fill="Transparent" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Text}" FontFamily="PlexSansMedium" FontSize="13.5"
                       TextColor="{StaticResource SidebarText}" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>

    <ShellContent Route="login" ContentTemplate="{DataTemplate v:LoginPage}" FlyoutItemIsVisible="False" />
    <FlyoutItem x:Name="PanelItem" Title="Panel" Route="panel" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:PanelPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="KasaSayimiItem" Title="Kasa Sayımı" Route="kasasayimi" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:KasaSayimiPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="HaftalikItem" Title="Haftalık" Route="haftalik" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:HaftalikPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="AylikItem" Title="Aylık" Route="aylik" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:AylikPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="GrafiklerItem" Title="Grafikler" Route="grafikler" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:GrafiklerPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="CarilerItem" Title="Cariler" Route="cariler" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:CarilerPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="CariOzetiItem" Title="Cari Özeti" Route="cariozeti" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:CariOzetiPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="IslemlerItem" Title="İşlemler" Route="islemler" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:IslemlerPage}" />
    </FlyoutItem>
    <!-- Paket C: gelen tablosu (her iki rol) ve Excel'den toplu yükleme (yalnız editör) -->
    <FlyoutItem x:Name="GelenlerItem" Title="Gelenler" Route="gelenler" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:GelenlerPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="TopluGirisItem" Title="Toplu Yükleme" Route="toplu" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:TopluGirisPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="KartlarItem" Title="Kredi Kartları" Route="kartlar" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:KrediKartlariPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="CeklerItem" Title="Çekler" Route="cekler" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:CeklerPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="SorularItem" Title="Sorular" Route="sorular" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:SorularPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="GecmisItem" Title="Geçmiş" Route="gecmis" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:GecmisPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="AyarlarItem" Title="Ayarlar" Route="ayarlar" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate v:AyarlarPage}" />
    </FlyoutItem>
    <MenuItem x:Name="CikisMenu" Text="Çıkış" Clicked="CikisTiklandi" />
</Shell>
