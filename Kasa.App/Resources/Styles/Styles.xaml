        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- ===== TAKİP SAYFALARI (kodla yazılmış sayfalar; Views/TakipUi.cs) =====
         Tek sistem (docs/specs/2026-11-26-slop-temizligi.md §7): XAML sayfalarının ölçeği. Sayfa başlığı LblPageTitle (21), kart ve
         panel başlığı bölüm başlığıyla aynı (14 kalın), özet satırı 15, gövde 14, ikincil 12-13 gri. Eski 28 ve 18 pt kalktı. -->
    <Style x:Key="LblTakipKartBaslik" TargetType="Label" BasedOn="{StaticResource LblSection}" />
    <Style x:Key="LblTakipBuyuk" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <!-- Kalan kısa ipucu ve liste özeti ikincil metindir (gri): asıl içerikle yarışmaz (sadeleştirme §2). -->
    <Style x:Key="LblTakipMetin" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Sub}" />
    </Style>
    <!-- Alan etiketi ve küçük yardımcı metin: XAML'ın LblField'ı gibi gri. -->
    <Style x:Key="LblTakipKucuk" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Sub}" />
