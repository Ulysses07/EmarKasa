<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · Styles.xaml — tek görsel sistem (docs/specs/2026-11-26-slop-temizligi.md §7)
     Tipografi: sayfa başlığı 21 / bölüm ve kart başlığı 14 kalın (cümle biçimi) / gövde 14 / ikincil 12-13 gri / tutar 14.5 kalın /
     özet tutarı 36. Windows'ta kalın yazı Semibold çizilir (WinUI.YerelGorunum). Boşluklar 4'ün katı.
     Yazı ailesi tek anahtardan (YaziAilesi) gelir; sayfalar aileyi kendisi yazmaz. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:Kasa.App.Controls">

    <!-- Her iki platform kendi sistem yazı tipini kullanır; menü ikonları ortak MauiImage kaynaklarıdır. -->
    <OnPlatform x:Key="YaziAilesi" x:TypeArguments="x:String" Default="Segoe UI Variable Text, Segoe UI">
        <On Platform="iOS" Value="Helvetica Neue" />
    </OnPlatform>

    <!-- MAUI 10 sayfaları edge-to-edge açar. iPhone formları çentik, ana ekran çizgisi ve klavyeden uzak kalır. -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="SafeAreaEdges">
            <Setter.Value>
                <OnPlatform x:TypeArguments="SafeAreaEdges" Default="None">
                    <On Platform="iOS" Value="All" />
                </OnPlatform>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ETİKETLER ===== -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="LblPageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="LblPageSub" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{StaticResource Sub}" />
    </Style>
    <!-- Bölüm başlığı: cümle biçiminde, harf aralığı yok (BÜYÜK HARF üst etiket yapay arayüz işaretiydi; sadeleştirme §5). Tablo sütun
         başlıkları LblRowSecondary'dir. -->
    <Style x:Key="LblSection" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="LblField" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Sub}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="LblRowPrimary" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
    <Style x:Key="LblRowSecondary" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="LblMoney" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>
    <Style x:Key="LblMoneyPos" TargetType="Label" BasedOn="{StaticResource LblMoney}">
        <Setter Property="TextColor" Value="{StaticResource Pos}" />
    </Style>
    <Style x:Key="LblMoneyNeg" TargetType="Label" BasedOn="{StaticResource LblMoney}">
        <Setter Property="TextColor" Value="{StaticResource Neg}" />
    </Style>
    <Style x:Key="LblHeroLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource HeroLabel}" />
    </Style>
    <Style x:Key="LblHeroAmount" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="TextColor" Value="White" />
    </Style>
    <Style x:Key="LblHeroSub" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{StaticResource HeroSub}" />
    </Style>
    <Style x:Key="LblError" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{StaticResource Neg}" />
    </Style>
    <Style x:Key="LblEmptyTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="LblEmptySub" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{StaticResource Sub}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- ===== GİRİŞ ALANLARI ===== -->
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="TitleColor" Value="{StaticResource Muted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="38" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Kanal seçim çipleri -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushCard}" />
        <Setter Property="Stroke" Value="{StaticResource BrushBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinimumHeightRequest" Value="38" />
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding Secili}" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushGreenSoft}" />
                <Setter Property="Stroke" Value="{StaticResource Green}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ChipText" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding Secili}" Value="True">
                <Setter Property="TextColor" Value="{StaticResource Green}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- CipGrubu çipleri gerçek düğmedir: görünüm eski Border + Label çipiyle aynı; Tab/Enter/Space ve ekran okuyucu
         için seçili durum ipucu eklenir. Odak kenarı düğme odaklandığında görünür. -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HeightRequest" Value="-1" />
        <Setter Property="MinimumHeightRequest" Value="38" />
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="SemanticProperties.Hint" Value="Seçili değil" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{StaticResource Ink}" />
                            <Setter Property="BorderWidth" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="FieldBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushCard}" />
        <Setter Property="Stroke" Value="{StaticResource BrushFieldStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>
    <Style x:Key="EntryMoney" TargetType="Entry">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="Keyboard" Value="Numeric" />
    </Style>
    <!-- Tüm para girişleri (XAML ve TakipUi) aynı görünür; geçersiz metinde kontrol yalnız metin rengini değiştirir. -->
    <Style TargetType="ctl:ParaGirisi" BasedOn="{StaticResource EntryMoney}" />
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Green}" />
        <Setter Property="ThumbColor" Value="White" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource Green}" />
    </Style>
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Green}" />
    </Style>

    <!-- ===== BUTONLAR =====
         Yeşil yalnız ana düğme, marka ve gelir içindir (docs/specs/2026-11-26-slop-temizligi.md §1). Örtük düğme ikincildir (beyaz
         zemin, ince kenar, koyu yazı): kodla yaratılan düğme kendiliğinden ana düğme olmaz. Ana düğme BtnPrimary ile bilerek seçilir
         (açık formun kaydetmesi ya da sayfanın tek asıl işi), yıkıcı eylem BtnDanger'dır. MAUI açık anahtarlı stille örtük stili
         birleştirir: açık stiller örtük stilin kenarını gerekirse kendisi sıfırlar (BtnPrimary, BtnRowEdit, SeffafDugme). -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Card}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AppBg}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AppBg}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AppBg}" />
                            <Setter Property="TextColor" Value="{StaticResource Muted}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Green}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GreenDark}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GreenDark}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DisabledBg}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <!-- Bağlantı düğmesi: aşamalı gösterimin "Ayrıntılar"ı (TakipUi.Yardim). Kenarsız, zeminsiz, yeşil yazı. -->
    <Style x:Key="BtnLink" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Green}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="HeightRequest">
            <Setter.Value>
                <OnPlatform x:TypeArguments="x:Double" Default="28">
                    <On Platform="iOS" Value="44" />
                </OnPlatform>
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource GreenDark}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <!-- Küçük ikincil düğme: sayfa başlığının Yenile'si (SayfaBasligi). iPhone'da dokunma hedefi 44. -->
    <Style x:Key="BtnKucuk" TargetType="Button">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest">
            <Setter.Value>
                <OnPlatform x:TypeArguments="x:Double" Default="32">
                    <On Platform="iOS" Value="44" />
                </OnPlatform>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Yıkıcı eylem (Sil, Seçili kuralı sil, Son hareketi geri al): ikincil düğme, kırmızı yazı; üzerine gelince açık kırmızı. -->
    <Style x:Key="BtnDanger" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource Neg}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource NegSoft}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource NegSoft}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AppBg}" />
                            <Setter Property="TextColor" Value="{StaticResource Muted}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="BtnSecondary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="BackgroundColor" Value="{StaticResource Card}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AppBg}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AppBg}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="BtnRowEdit" TargetType="Button">
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource GreenSoft}" />
        <Setter Property="TextColor" Value="{StaticResource Green}" />
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest">
            <Setter.Value>
                <OnPlatform x:TypeArguments="x:Double" Default="32">
                    <On Platform="iOS" Value="44" />
                </OnPlatform>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource GreenSoftHover}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="BtnRowDelete" TargetType="Button" BasedOn="{StaticResource BtnRowEdit}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Neg}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource NegSoft}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Şeffaf düğme: menü öğesinin ve kart kutusunun tıklama/klavye yüzeyi (Tab ile odaklanır, UI Otomasyonu'nda adıyla
         görünür). Zemin ve görsel durum yazmaz, zemini üstündeki öğe çizer. MAUI açık anahtarlı stille birlikte örtük Button
         stilini de uygular: onun sabit yüksekliği (44; düğme kutunun ortasında şerit kalıyordu) HeightRequest=-1 (ayarsız) ile,
         görsel durumları (PointerOver/Pressed yeşil, Disabled DisabledBg zemin) burada saydam durumlarla ezilir; düğme bulunduğu
         hücreyi doldurur ve hiçbir durumda zemin boyamaz (KartKutusuTests). Düz renk BackgroundColor ile (dotnet/maui#38813). -->
    <Style x:Key="SeffafDugme" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="-1" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ===== KARTLAR & KUTULAR ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushCard}" />
        <Setter Property="Stroke" Value="{StaticResource BrushBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Shadow">
            <Shadow Brush="#20261F" Opacity="0.05" Radius="6" Offset="0,2" />
        </Setter>
    </Style>
    <Style x:Key="CardForm" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="CardHero" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushGreen}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="28,26" />
        <Setter Property="Shadow">
            <Shadow Brush="#1E5F46" Opacity="0.08" Radius="8" Offset="0,2" />
        </Setter>
    </Style>
    <Style x:Key="ErrorBox" TargetType="Border">
        <Setter Property="Background">
            <SolidColorBrush Color="{StaticResource NegSoft}" />
        </Setter>
        <Setter Property="Stroke" Value="{StaticResource BrushNegBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="DateChip" TargetType="Border">
        <Setter Property="Background">
            <SolidColorBrush Color="{StaticResource DateChipBg}" />
        </Setter>
        <Setter Property="Stroke" Value="{StaticResource BrushDateChipBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="0,5" />
        <Setter Property="WidthRequest" Value="52" />
    </Style>
    <Style x:Key="LblDateChip" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{StaticResource Sub}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="AvatarChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushGreenSoft}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 9" />
        <Setter Property="WidthRequest" Value="28" />
        <Setter Property="HeightRequest" Value="28" />
    </Style>
    <Style x:Key="LblAvatar" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource YaziAilesi}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Green}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="RowSeparator" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource RowLine}" />
    </Style>
    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
