<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Emar Kasa tema renkleri -->
    <!-- İkincil yazı renkleri (Sub, Muted, HeroLabel, HeroSub, SidebarMuted) kullanıldıkları zeminde en az 4,5:1 kontrast
         verir (WCAG 2.2 1.4.3); ton korunup yalnız eşiği geçecek kadar koyulaştırıldı/açıldı. Kasa.App.Core.Tests sınar. -->
    <Color x:Key="AppBg">#F5F4EF</Color>
    <Color x:Key="Card">#FFFFFF</Color>
    <Color x:Key="Ink">#20261F</Color>
    <Color x:Key="Sub">#6C7163</Color>
    <Color x:Key="Muted">#6C7261</Color>
    <!-- Pasif düğme zemini: eski Muted tonu. WCAG 1.4.3 pasif bileşeni kapsam dışı tutar; açık görünüm korunur. -->
    <Color x:Key="DisabledBg">#9AA08F</Color>
    <Color x:Key="Border">#E3E0D6</Color>
    <!-- Form alanı (FieldBorder) sınırı: alanın tek görsel sınırıdır, beyaz alan içine ve kart, sayfa, kalem düzenleyicisi
         zeminlerine karşı en az 3:1 verir (WCAG 2.2 1.4.11). Kart ve ayırıcı kenarlıkları (Border) süs olarak açık kalır. -->
    <Color x:Key="FieldStroke">#948966</Color>
    <Color x:Key="RowLine">#F1EFE8</Color>
    <Color x:Key="Green">#1E5F46</Color>
    <Color x:Key="GreenDark">#174D38</Color>
    <Color x:Key="GreenSoft">#F0F5F1</Color>
    <Color x:Key="Pos">#1B7A4E</Color>
    <Color x:Key="Neg">#C13A2E</Color>
    <Color x:Key="Sidebar">#1F2A23</Color>
    <Color x:Key="SidebarActive">#33453A</Color>
    <Color x:Key="SidebarText">#C9D2C6</Color>
    <Color x:Key="SidebarTitle">#F2F5EE</Color>

    <!-- Emar Kasa tasarım eklentileri (handoff) -->
    <Color x:Key="ChipBg">#F1EFE8</Color>
    <Color x:Key="DateChipBg">#F5F4EF</Color>
    <Color x:Key="DateChipBorder">#EFEDE4</Color>
    <Color x:Key="GreenSoftHover">#E2EBE4</Color>
    <Color x:Key="NegSoft">#FAEDEB</Color>
    <Color x:Key="NegBorder">#F0D2CC</Color>
    <Color x:Key="HeroLabel">#B3CFC0</Color>
    <Color x:Key="HeroSub">#B5CEC2</Color>
    <Color x:Key="SidebarHover">#2A3830</Color>
    <Color x:Key="SidebarMuted">#869184</Color>
    <Color x:Key="SidebarAccent">#9CC4AC</Color>
    <Color x:Key="SidebarLine">#14FFFFFF</Color>
    <Color x:Key="FocusRing">#2E1E5F46</Color>

    <!-- Uyarı ve bilgi kutuları (dağılım bekliyor, veri sağlığı, kaydedilmemiş değişiklik, iade açıklaması) -->
    <Color x:Key="UyariMetin">#765100</Color>
    <Color x:Key="UyariZemin">#FFF2D9</Color>
    <Color x:Key="UyariKenar">#E9C880</Color>
    <!-- Kapatılmış (dondurulmuş) ay bilgisi -->
    <Color x:Key="KilitZemin">#E3EDDF</Color>
    <Color x:Key="KilitMetin">#366341</Color>
    <!-- Yeşil hero kart üzerindeki açık metin ve uyarı -->
    <Color x:Key="HeroAcik">#CBE6D5</Color>
    <Color x:Key="HeroUyari">#FFDA91</Color>
    <!-- Alış kalemi düzenleyicisi ve ödeme kanal payları zeminleri -->
    <Color x:Key="KalemZemin">#F8F8F3</Color>
    <Color x:Key="PayZemin">#F1F5EE</Color>
    <!-- Kodla yazılmış takip sayfalarının hata ve bilgi metni (MAUI adlı renkleri Colors.DarkRed / Colors.DarkGreen) -->
    <Color x:Key="KoyuKirmizi">DarkRed</Color>
    <Color x:Key="KoyuYesil">DarkGreen</Color>

    <!-- Sık kullanılan fırçalar -->
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource Card}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BrushFieldStroke" Color="{StaticResource FieldStroke}" />
    <SolidColorBrush x:Key="BrushRowLine" Color="{StaticResource RowLine}" />
    <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource Green}" />
    <SolidColorBrush x:Key="BrushGreenSoft" Color="{StaticResource GreenSoft}" />
    <SolidColorBrush x:Key="BrushNegBorder" Color="{StaticResource NegBorder}" />
    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource Sidebar}" />
    <SolidColorBrush x:Key="BrushDateChipBorder" Color="{StaticResource DateChipBorder}" />
    <SolidColorBrush x:Key="BrushUyariKenar" Color="{StaticResource UyariKenar}" />
</ResourceDictionary>