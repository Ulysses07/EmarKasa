<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- İki ayrı ürün paketi, aynı uygulama: Windows'ta masaüstü, bulut macOS runner'ında iOS.
		     Mac derlemesine Windows hedefi eklenmez; Windows'ta iOS iş yükü gerekmez. -->
		<TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-ios</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Kasa.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Derlenmiş bağlamalar (x:DataType; Kasa.App.Core.Tests MauiKayitTutarliligiTests x:DataType'ı gerçek bağlam türüyle
		     karşılaştırır): XAML kaynak üreteci bağlama yolunu x:DataType türünde bulamazsa (MAUIG2045) ya da DataTemplate
		     x:DataType'ı dış kapsamdan devralırsa (MAUIG2024) derleme durur. XC0022-XC0025 XamlC'nin derlenmiş bağlama
		     uyarılarıdır (bir dosya ya da proje XamlC'ye dönerse). Kaynak: learn.microsoft.com/dotnet/maui/fundamentals/data-binding/compiled-bindings -->
		<WarningsAsErrors>$(WarningsAsErrors);MAUIG2024;MAUIG2045;XC0022;XC0023;XC0024;XC0025</WarningsAsErrors>

		<!-- Display name -->
		<ApplicationTitle>Emar Kasa</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.royalmezat.kasa</ApplicationId>

		<!-- Sürüm: tek kaynak depo kökündeki Directory.Build.props (KasaSurumu; en çok üç parça). MAUI Windows'ta Version'ı da
		     buna eşitler; uygulamanın gösterdiği sürüm Kasa.App.Core derlemesinin aynı değerli meta verisinden okunur.
		     ApplicationVersion yayın başına artan tam sayıdır (derleme numarası). -->
		<ApplicationDisplayVersion>$(KasaSurumu)</ApplicationDisplayVersion>
		<ApplicationVersion>8</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>

		<!-- SecureStorage simülatörde Keychain hakkı ister; cihaz/TestFlight paketi bu dosyayı kullanmaz. -->
		<CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and $(RuntimeIdentifier.StartsWith('iossimulator-'))">Platforms/iOS/SimulatorEntitlements.plist</CodesignEntitlements>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Uygulama ikonu: web/PWA ikonuyla (Kasa.Api/wwwroot/icon.svg) aynı marka işareti. Arka plan (Include) marka
		     yeşili, ön plan (ForegroundFile) krem "K"; Color arka planı aynı yeşille doldurur (iOS/Mac'te saydam ikon kabul edilmez). -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#194D3C" />

		<!-- Açılış ekranı (Android/iOS'ta gösterilir): marka yeşili zeminde krem "K". -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#194D3C" BaseSize="128,128" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kasa.App.Core\Kasa.App.Core.csproj" />
	</ItemGroup>

</Project>
