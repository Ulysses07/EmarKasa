<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · BildirimAyarlariPage — Paket A: Panel → "Bildirimler" düğmesiyle açılır (izleyici de; Ayarlar
     yalnız editörde). İçerik Ayarlar'daki bölümle aynı görünümdür. -->
<ContentPage
    x:Class="Kasa.App.Views.BildirimAyarlariPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="clr-namespace:Kasa.App.Views"
    Title="Bildirimler"
    BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Desktop='28,22', Default='16,14'}" Spacing="20"
                             MaximumWidthRequest="760">
            <VerticalStackLayout Spacing="3">
                <Label Text="Bildirim ayarları" Style="{StaticResource LblPageTitle}" />
                <Label Text="Hangi bildirimlerin bu bilgisayarda gösterileceğini seçin" Style="{StaticResource LblPageSub}" />
            </VerticalStackLayout>
            <v:BildirimAyarlariView />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
