<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:Kasa.App.Controls"
             xmlns:core="clr-namespace:Kasa.App.Core;assembly=Kasa.App.Core"
             xmlns:api="clr-namespace:Kasa.ApiClient;assembly=Kasa.ApiClient"
             x:DataType="core:AlislarViewModel"
             x:Class="Kasa.App.Views.AlislarPage" x:Name="Sayfa"
             Title="Alışlar" BackgroundColor="{StaticResource AppBg}">
    <Grid Padding="{OnIdiom Desktop='24,18', Default='16,14'}" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <ctl:UyumluIzgara ColumnDefinitions="*,Auto,Auto" DarSutunlar="*,*" ColumnSpacing="10" RowSpacing="8">
            <VerticalStackLayout ctl:UyumluIzgara.DarSatir="0" ctl:UyumluIzgara.DarSutunAraligi="2" Spacing="3">
                <Label Text="Alışlar" Style="{StaticResource LblPageTitle}" />
                <Label Text="Kalemleri kaydedin, kanallara dağıtın, inceleme ve ödemeleri takip edin." Style="{StaticResource LblPageSub}" />
                <!-- Son güncelleme: hiç yükleme yokken "Henüz yüklenmedi.", eski veride "güncel olmayabilir" (tasarım 2026-10-02 §3). -->
                <Label Text="{Binding SonGuncellemeMetni}" Style="{StaticResource LblPageSub}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" ctl:UyumluIzgara.DarSatir="1" Text="Yenile" Command="{Binding YenileCommand}" Style="{StaticResource BtnSecondary}" VerticalOptions="Center" />
            <Button Grid.Column="2" ctl:UyumluIzgara.DarSatir="1" ctl:UyumluIzgara.DarSutun="1" Text="+ Yeni alış" Clicked="YeniAlisTiklandi"
                    VerticalOptions="Center" IsEnabled="{Binding Mesgul, Converter={StaticResource TersIse}}" />
        </ctl:UyumluIzgara>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <!-- Şerit boşken gizlenir: aşağıdaki ileti ve uyarı kutusu yukarı kayar (eski düz yerleşimle aynı). -->
            <ctl:DurumSeridi Mesgul="{Binding Mesgul}" YukleniyorMetni="İşlem tamamlanıyor…" Hata="{Binding Hata}" HataKutusu="True" />
            <Label Text="{Binding Mesaj}" TextColor="{StaticResource Green}" IsVisible="{Binding Mesaj, Converter={StaticResource DoluIse}}" />
            <Border BackgroundColor="{StaticResource UyariZemin}" Stroke="{StaticResource BrushUyariKenar}" StrokeShape="RoundRectangle 10" Padding="14,10" IsVisible="{Binding DagilimBekliyor}">
                <Label TextColor="{StaticResource UyariMetin}">
                    <Label.FormattedText><FormattedString>
                        <Span Text="DAĞILIM BEKLİYOR  ·  " FontAttributes="Bold" />
                        <Span Text="{Binding DagilimBekleyenTutar, Converter={StaticResource ParaBicim}}" FontAttributes="Bold" />
                        <Span Text="  Ödemeler kaydedildi; onay tamamlanana kadar kanal raporları bu tutarı içermez." />
                    </FormattedString></Label.FormattedText>
                </Label>
            </Border>
        </VerticalStackLayout>

        <ctl:UyumluBolmeler x:Name="AlisBolmeleri" Grid.Row="2" GenisSutunlar="300,*" IlkBaslik="Kayıtlar" IkinciBaslik="Alış / ödeme"
                           ColumnSpacing="18" IsVisible="{Binding GovdeGorunur}" IsEnabled="{Binding Mesgul, Converter={StaticResource TersIse}}">
            <!-- Yükleme hata verse de son başarılı liste görünür kalır ve soluk gösterilir (HD-01). -->
            <ctl:UyumluBolmeler.Triggers>
                <DataTrigger TargetType="ctl:UyumluBolmeler" Binding="{Binding VeriEski}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </ctl:UyumluBolmeler.Triggers>
            <ctl:UyumluBolmeler.Ilk>
            <Border Style="{StaticResource Card}">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Padding="14">
                    <Label Text="ALIŞ KAYITLARI" Style="{StaticResource LblSection}" />
                    <CollectionView Grid.Row="1" ItemsSource="{Binding Alislar}" SelectionMode="None">
                        <CollectionView.ItemTemplate><DataTemplate x:DataType="core:AlisSatiri">
                            <!-- Açık (düzenlenen) kayıt listede vurgulanır (tasarım 2026-10-02 §2): GreenSoft zemine ek
                                 olarak çerçeve; yatay iç boşluk satırı kenardan ayırır. -->
                            <Border Padding="12,12" StrokeThickness="0" StrokeShape="Rectangle">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource EsitIse}">
                                                <Binding Path="Veri.Id" />
                                                <Binding Path="BindingContext.Secili.Id" Source="{x:Reference Sayfa}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="BackgroundColor" Value="{StaticResource GreenSoft}" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                        <Setter Property="Stroke" Value="{StaticResource BrushGreen}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Baslik}" Style="{StaticResource LblRowPrimary}" />
                                    <Label Text="{Binding Alt}" Style="{StaticResource LblRowSecondary}" />
                                    <Label Text="{Binding Tutar}" FontSize="12" FontAttributes="Bold" />
                                    <Button Text="Kaydı aç" Style="{StaticResource BtnSecondary}" HorizontalOptions="Start"
                                            Clicked="AlisAcTiklandi" CommandParameter="{Binding .}" />
                                    <BoxView Style="{StaticResource RowSeparator}" Margin="0,6,0,0" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate></CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="Henüz alış yok. Yeni alış düğmesinden ilk kaydı oluşturun."
                                   Style="{StaticResource LblPageSub}" Margin="0,20" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                    <Button Grid.Row="2" Text="Alıcı hesaplarını yönet" Clicked="HesaplarTiklandi" IsVisible="{Binding EditorMu}" Style="{StaticResource BtnSecondary}" />
                </Grid>
            </Border>
            </ctl:UyumluBolmeler.Ilk>

            <ctl:UyumluBolmeler.Ikinci>
            <ScrollView x:Name="DetayKaydirici">
                <VerticalStackLayout Spacing="16" Padding="0,0,4,24">
                    <Border Style="{StaticResource CardHero}" Padding="22,18">
                        <VerticalStackLayout Spacing="8">
                            <ctl:UyumluIzgara ColumnDefinitions="*,Auto" RowSpacing="8">
                                <Label Text="{Binding Baslik}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                                <Label Grid.Column="1" Text="{Binding Durum}" TextColor="{StaticResource HeroAcik}" FontAttributes="Bold" VerticalOptions="Center" />
                            </ctl:UyumluIzgara>
                            <Label Text="{Binding KaydiAcan}" Style="{StaticResource LblHeroSub}" />
                            <Label Text="{Binding ToplamMetni}" FontSize="29" FontAttributes="Bold" TextColor="White" />
                            <Label Text="{Binding OdemeOzeti}" TextColor="{StaticResource HeroAcik}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border BackgroundColor="{StaticResource UyariZemin}" Stroke="{StaticResource BrushUyariKenar}" StrokeShape="RoundRectangle 10" Padding="14"
                            IsVisible="{Binding EditorNotu, Converter={StaticResource DoluIse}}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Editörün iade açıklaması" FontAttributes="Bold" TextColor="{StaticResource UyariMetin}" />
                            <Label Text="{Binding EditorNotu}" TextColor="{StaticResource UyariMetin}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardForm}" x:Name="AlisFormu">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="1 · ALIŞ BİLGİLERİ VE KALEMLER" Style="{StaticResource LblSection}" />
                            <!-- Düzenleme modu ve formun genel hatası formun en üstünde (tasarım 2026-10-02 §1-2; AL-01). -->
                            <Label Text="{Binding FormBasligi}" Style="{StaticResource LblRowPrimary}" FontAttributes="Bold"
                                   IsVisible="{Binding Duzenlenebilir}" SemanticProperties.HeadingLevel="Level2" />
                            <Border x:Name="FormHataKutusu" Style="{StaticResource ErrorBox}"
                                    IsVisible="{Binding Hatalar.Genel, Converter={StaticResource DoluIse}}">
                                <Label Text="{Binding Hatalar.Genel}" Style="{StaticResource LblError}" />
                            </Border>
                            <VerticalStackLayout Spacing="12" IsEnabled="{Binding Duzenlenebilir}">
                                <ctl:UyumluIzgara ColumnDefinitions="160,*" ColumnSpacing="12" RowSpacing="8">
                                    <ctl:FormAlani Baslik="Tarih" Alan="Tarih" Hata="{Binding Hatalar[Tarih]}">
                                        <DatePicker Date="{Binding Tarih}" />
                                    </ctl:FormAlani>
                                    <ctl:FormAlani Grid.Column="1" Baslik="Tedarikçi / açıklama" Alan="Tedarikci" Hata="{Binding Hatalar[Tedarikci]}">
                                        <Entry Text="{Binding Tedarikci}" Placeholder="Firma veya kişi adı" />
                                    </ctl:FormAlani>
                                </ctl:UyumluIzgara>
                                <ctl:FormAlani Alan="AlisNotu" Hata="{Binding Hatalar[AlisNotu]}">
                                    <Entry Text="{Binding AlisNotu}" Placeholder="Alış notu (isteğe bağlı)" />
                                </ctl:FormAlani>
                                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Kalemler}">
                                    <BindableLayout.ItemTemplate><DataTemplate x:DataType="core:AlisKalemEditor">
                                        <Border BackgroundColor="{StaticResource KalemZemin}" Stroke="{StaticResource BrushBorder}" StrokeShape="RoundRectangle 10" Padding="14">
                                            <VerticalStackLayout Spacing="10">
                                                <ctl:UyumluIzgara ColumnDefinitions="*,150,Auto" ColumnSpacing="8" RowSpacing="8">
                                                    <VerticalStackLayout>
                                                        <Label Text="Kalem açıklaması" Style="{StaticResource LblField}" />
                                                        <Border Style="{StaticResource FieldBorder}">
                                                            <Entry Text="{Binding Aciklama}" Placeholder="Örn. ürün / hizmet" />
                                                        </Border>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="1">
                                                        <Label Text="Kalem tutarı" Style="{StaticResource LblField}" />
                                                        <Border Style="{StaticResource FieldBorder}">
                                                            <ctl:ParaGirisi Tutar="{Binding Tutar}" Placeholder="0,00 ₺" />
                                                        </Border>
                                                    </VerticalStackLayout>
                                                    <Button Grid.Column="2" Text="Kaldır" Style="{StaticResource BtnRowDelete}" VerticalOptions="End"
                                                            Command="{Binding BindingContext.KalemSilCommand, Source={x:Reference Sayfa}}"
                                                            CommandParameter="{Binding .}" />
                                                </ctl:UyumluIzgara>
                                                <Label Text="Kanal dağılımı · aynı kalemi birden fazla kanala ayırabilirsiniz" FontSize="12" TextColor="{StaticResource Sub}" />
                                                <VerticalStackLayout Spacing="7" BindableLayout.ItemsSource="{Binding Dagilimlar}">
                                                    <BindableLayout.ItemTemplate><DataTemplate x:DataType="core:AlisDagilimEditor">
                                                        <ctl:UyumluIzgara ColumnDefinitions="*,150,Auto" ColumnSpacing="8" RowSpacing="8">
                                                            <Border Style="{StaticResource FieldBorder}">
                                                                <Picker Title="Kanal seçin" ItemsSource="{Binding Kanallar}"
                                                                        ItemDisplayBinding="{Binding Ad, x:DataType=api:AlisKanalDto}"
                                                                        SelectedItem="{Binding Kanal}" />
                                                            </Border>
                                                            <Border Grid.Column="1" Style="{StaticResource FieldBorder}"><ctl:ParaGirisi Tutar="{Binding Tutar}" Placeholder="Pay (₺)" /></Border>
                                                            <Button Grid.Column="2" Text="Kaldır" Style="{StaticResource BtnRowDelete}"
                                                                    Command="{Binding BindingContext.DagilimSilCommand, Source={x:Reference Sayfa}}"
                                                                    CommandParameter="{Binding .}" />
                                                        </ctl:UyumluIzgara>
                                                    </DataTemplate></BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                    <Button Text="+ Kanal payı" Style="{StaticResource BtnSecondary}"
                                                            Command="{Binding BindingContext.DagilimEkleCommand, Source={x:Reference Sayfa}}"
                                                            CommandParameter="{Binding .}" />
                                                    <Label Grid.Column="1" Text="{Binding DagilimOzeti}" Style="{StaticResource LblPageSub}" VerticalOptions="Center" />
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate></BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Button Text="+ Alış kalemi ekle" Command="{Binding KalemEkleCommand}" Style="{StaticResource BtnSecondary}" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                            <Label Text="{Binding DagilimOzeti}" FontAttributes="Bold" />
                            <Label Text="Kaydedilmemiş değişiklikler var." TextColor="{StaticResource UyariMetin}" IsVisible="{Binding KaydedilmemisDegisiklikVar}" />
                            <FlexLayout Wrap="Wrap" AlignItems="Center">
                                <Button Text="{Binding KaydetMetni}" Command="{Binding KaydetCommand}" IsVisible="{Binding Duzenlenebilir}" Margin="0,0,10,6" />
                                <Button Text="İncelemeye gönder" Command="{Binding GonderCommand}" IsVisible="{Binding Gonderilebilir}" Style="{StaticResource BtnSecondary}" Margin="0,0,10,6" />
                                <Button Text="Kaydet ve onayla" Command="{Binding OnaylaCommand}" IsVisible="{Binding Onaylanabilir}" Margin="0,0,10,6" />
                                <Button Text="Değişiklikleri bırak" Clicked="DegisiklikleriBirakTiklandi"
                                        IsVisible="{Binding KaydedilmemisDegisiklikVar}" Style="{StaticResource BtnSecondary}" Margin="0,0,10,6" />
                            </FlexLayout>
                            <Label Text="Onay için her kalemin dağılımı kendi tutarına eşit olmalıdır. Onaylanmış bir alış, düzenlenmeden önce iade edilir." Style="{StaticResource LblPageSub}" />
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IadeEdilebilir}">
                                <BoxView Style="{StaticResource RowSeparator}" />
                                <Label Text="Düzeltme için alıcıya iade et" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding IadeNedeni}" Placeholder="İade nedeni (zorunlu)" /></Border>
                                <Button Text="Açıklamayla iade et" Command="{Binding IadeCommand}" Style="{StaticResource BtnSecondary}" HorizontalOptions="Start" />
                                <Label Text="Mevcut ödemeler korunur. Yeniden onaya kadar kanal dağılımı bekler." Style="{StaticResource LblPageSub}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardForm}" IsVisible="{Binding OdemeAlaniGorunur}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="2 · ÖDEME / MEVCUT GİDER BAĞLANTISI" Style="{StaticResource LblSection}" />
                            <Label Text="{Binding OdemeOzeti}" FontAttributes="Bold" />
                            <ctl:UyumluSatir Spacing="10">
                                <Switch IsToggled="{Binding MevcutGiderKullan}" />
                                <Label Text="Önceden kaydedilmiş gideri bağla" VerticalOptions="Center" />
                            </ctl:UyumluSatir>
                            <VerticalStackLayout Spacing="6" IsVisible="{Binding MevcutGiderKullan}">
                                <ctl:UyumluIzgara ColumnDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="8">
                                    <Border Style="{StaticResource FieldBorder}">
                                        <Entry Text="{Binding GiderArama}" Placeholder="Açıklama, not veya tutar ile ara" ReturnCommand="{Binding GiderAraCommand}" />
                                    </Border>
                                    <Button Grid.Column="1" Text="Ara" Command="{Binding GiderAraCommand}" Style="{StaticResource BtnSecondary}" />
                                </ctl:UyumluIzgara>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Picker Title="Mevcut gideri seçin" ItemsSource="{Binding BaglanabilirGiderler}"
                                            ItemDisplayBinding="{Binding Ad, x:DataType=core:GiderSecenegi}" SelectedItem="{Binding SeciliGider}" />
                                </Border>
                                <Button Text="Daha eski giderleri göster" Command="{Binding DahaFazlaGiderCommand}"
                                        IsVisible="{Binding DahaFazlaGiderVar}" Style="{StaticResource BtnSecondary}" HorizontalOptions="Start" />
                                <Label Text="Bu seçenek yeni gider oluşturmaz; seçilen kaydın tarihi ve tutarı kullanılır. Liste en yeni bağlanabilir giderlerle başlar; eskisi için arayın."
                                       Style="{StaticResource LblPageSub}" />
                            </VerticalStackLayout>
                            <ctl:UyumluIzgara ColumnDefinitions="160,*" ColumnSpacing="12" IsEnabled="{Binding OdemeAlanlariAcik}" RowSpacing="8">
                                <VerticalStackLayout>
                                    <Label Text="Ödeme tarihi" Style="{StaticResource LblField}" />
                                    <Border Style="{StaticResource FieldBorder}">
                                        <DatePicker Date="{Binding OdemeTarihi}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Ödeme tutarı" Style="{StaticResource LblField}" />
                                    <Border Style="{StaticResource FieldBorder}">
                                        <ctl:ParaGirisi Tutar="{Binding OdemeTutari}" Placeholder="0,00 ₺" />
                                    </Border>
                                </VerticalStackLayout>
                            </ctl:UyumluIzgara>
                            <Border Style="{StaticResource FieldBorder}" IsVisible="{Binding YeniOdemeGirisi}">
                                <Picker Title="Ödeme yöntemi" ItemsSource="{Binding OdemeKartlari}"
                                        ItemDisplayBinding="{Binding Ad, x:DataType=core:OdemeKartiSecenegi}" SelectedItem="{Binding OdemeKarti}" />
                            </Border>
                            <VerticalStackLayout Spacing="6" IsVisible="{Binding KartHarcamasiBaglanabilir}">
                                <Button Text="Ekstreden gelen kart harcamasını bul" Command="{Binding KartHarcamalariniGetirCommand}" Style="{StaticResource BtnSecondary}" HorizontalOptions="Start" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Picker Title="Kart harcaması" ItemsSource="{Binding BaglanabilirKartHarcamalari}"
                                            ItemDisplayBinding="{Binding Ad, x:DataType=core:KartHarcamasiSecenegi}"
                                            SelectedItem="{Binding SeciliKartHarcamasi}" />
                                </Border>
                                <Label Text="Kart ekstresi önce içe aktarıldıysa harcama zaten kart borcundadır: onu seçin, ödeme bu harcamaya bağlanır ve ikinci harcama oluşmaz. Tarih ve tutar harcamadan alınır."
                                       Style="{StaticResource LblPageSub}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6" IsVisible="{Binding TaksitGirilebilir}">
                                <ctl:UyumluIzgara ColumnDefinitions="160,*" ColumnSpacing="12" RowSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="Taksit sayısı" Style="{StaticResource LblField}" />
                                        <Border Style="{StaticResource FieldBorder}">
                                            <Entry Text="{Binding OdemeTaksitSayisi}" Keyboard="Numeric" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <ctl:UyumluSatir Spacing="10">
                                            <Switch IsToggled="{Binding OdemeIlkKesimVar}" />
                                            <Label Text="İlk kesim tarihini belirt (isteğe bağlı)" VerticalOptions="Center" />
                                        </ctl:UyumluSatir>
                                        <Border Style="{StaticResource FieldBorder}" IsVisible="{Binding OdemeIlkKesimVar}"><DatePicker Date="{Binding OdemeIlkKesimTarihi}" /></Border>
                                    </VerticalStackLayout>
                                </ctl:UyumluIzgara>
                                <Label Text="Bankada taksitle çekildiyse taksit sayısını girin: her ekstreye yalnız taksit tutarı yazılır. İlk kesim boşsa ödemenin düştüğü ilk kesimdir."
                                       Style="{StaticResource LblPageSub}" />
                            </VerticalStackLayout>
                            <Label Text="Yeni takipte kart borcu ayrı izlenir; kasa, Kartlar ekranında ödeme kaydedilince azalır. Geçiş yapılmamış eski kartlar eski erteleme kuralını korur."
                                   Style="{StaticResource LblPageSub}" />
                            <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding OdemeNotu}" Placeholder="Ödeme notu (isteğe bağlı)" /></Border>
                            <Border BackgroundColor="{StaticResource PayZemin}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="14">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Bu ödemenin kanal payları" FontAttributes="Bold" />
                                    <Label Text="{Binding OnizlemeAciklamasi}" Style="{StaticResource LblPageSub}" />
                                    <VerticalStackLayout Spacing="5" BindableLayout.ItemsSource="{Binding OdemeOnizleme}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="api:AlisDagilimDto">
                                                <ctl:UyumluIzgara ColumnDefinitions="*,Auto" RowSpacing="8">
                                                    <Label Text="{Binding Kanal}" />
                                                    <Label Grid.Column="1" Text="{Binding Tutar, Converter={StaticResource ParaBicim}}" FontAttributes="Bold" />
                                                </ctl:UyumluIzgara>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                            <Label Text="Ödeme eklemek için önce alıştaki değişiklikleri kaydedin." TextColor="{StaticResource UyariMetin}" IsVisible="{Binding KaydedilmemisDegisiklikVar}" />
                            <Button Text="Ödemeyi kaydet / gideri bağla" Command="{Binding OdemeKaydetCommand}" HorizontalOptions="Start"
                                    IsEnabled="{Binding KaydedilmemisDegisiklikVar, Converter={StaticResource TersIse}}" />
                            <Border Style="{StaticResource CardForm}" IsVisible="{Binding OdemeBenzerlik.UyariVar}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding OdemeBenzerlik.Uyari}" />
                                    <Button Text="Ayrı bir işlem, devam et" Command="{Binding OdemeyiAyriKaydetCommand}" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardForm}" IsVisible="{Binding KayitVar}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="ÖDEME GEÇMİŞİ" Style="{StaticResource LblSection}" />
                            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Odemeler}">
                                <BindableLayout.EmptyView><Label Text="Bu alışa henüz ödeme bağlanmadı." Style="{StaticResource LblPageSub}" /></BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="core:AlisOdemeSatiri">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Baslik}" FontAttributes="Bold" />
                                            <Label Text="{Binding Dagilim}" Style="{StaticResource LblPageSub}" />
                                            <VerticalStackLayout IsVisible="{Binding BindingContext.EditorMu, Source={x:Reference Sayfa}}">
                                                <Button Text="Kartı aç" Style="{StaticResource BtnSecondary}" IsVisible="{Binding KartVar}" Clicked="KartAcTiklandi" CommandParameter="{Binding .}" />
                                            </VerticalStackLayout>
                                            <Button Text="Düzelt / taşı / iptal" Style="{StaticResource BtnSecondary}"
                                                    IsVisible="{Binding BindingContext.EditorMu, Source={x:Reference Sayfa}}"
                                                    Command="{Binding BindingContext.OdemeDuzeltCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            <BoxView Style="{StaticResource RowSeparator}" Margin="0,5,0,0" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardForm}" IsVisible="{Binding DuzeltmeAcik}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="ÖDEME DÜZELTMESİ" Style="{StaticResource LblSection}" />
                            <Label Text="{Binding DuzeltilecekOdeme.Baslik}" FontAttributes="Bold" />
                            <VerticalStackLayout Spacing="12" IsEnabled="{Binding DuzeltmeAlanlariAcik}">
                                <DatePicker Date="{Binding DuzeltmeTarihi}" />
                                <ctl:ParaGirisi Tutar="{Binding DuzeltmeTutari}" Placeholder="Ödeme tutarı" />
                                <Picker Title="Ödeme yöntemi" ItemsSource="{Binding DuzeltmeKartlari}"
                                        ItemDisplayBinding="{Binding Ad, x:DataType=core:OdemeKartiSecenegi}" SelectedItem="{Binding DuzeltmeKarti}" />
                            </VerticalStackLayout>
                            <Label Text="Bu ödeme kart takibinde: tarihi, tutarı ve kartı kart harcamasının kendisidir, değiştirilemez. Yanlış alışa girildiyse hedef alışı seçip taşıyın ya da ödemeyi alıştan ayırın."
                                   IsVisible="{Binding DuzeltmeTakipli}" Style="{StaticResource LblPageSub}" />
                            <Label Text="Bu eski kayıtta kart silinmiş. Kart harcaması niteliği korunur; yeni bir kart seçebilirsiniz."
                                   IsVisible="{Binding EskiKartHarcamasi}" Style="{StaticResource LblPageSub}" />
                            <Label Text="Yanlış alışa bağlandıysa hedef alış seçin. Boşsa aynı alışta kalır." Style="{StaticResource LblPageSub}" />
                            <Picker Title="Başka alışa taşı (isteğe bağlı)" ItemsSource="{Binding DuzeltmeHedefleri}"
                                    ItemDisplayBinding="{Binding Baslik, x:DataType=core:AlisSatiri}" SelectedItem="{Binding HedefAlis}" />
                            <Button Text="Aynı alışta bırak" Command="{Binding HedefiTemizleCommand}" Style="{StaticResource BtnSecondary}" />
                            <Entry Text="{Binding DuzeltmeAciklamasi}" Placeholder="Düzeltme / iptal açıklaması (zorunlu)" />
                            <Button Text="Düzeltmeyi kaydet" Command="{Binding OdemeDuzeltKaydetCommand}" />
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding DuzeltmeTakipli}">
                                <ctl:UyumluSatir Spacing="10">
                                    <Switch IsToggled="{Binding HarcamayiKoru}" />
                                    <Label Text="Kart harcaması gerçek: alıştan ayır, kart gideri olarak kalsın" VerticalOptions="Center" />
                                </ctl:UyumluSatir>
                                <Label Text="Seçilmezse kart harcaması hiç yapılmamış sayılır: ödenmemişse harcama ve taksitleri de kalkar; ödendiyse sunucu gerçek kanal dağılımını ister."
                                       Style="{StaticResource LblPageSub}" />
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding AyirmaPaylariGorunur}" BindableLayout.ItemsSource="{Binding AyirmaPaylari}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="core:AyirmaPayi">
                                            <ctl:UyumluIzgara ColumnDefinitions="*,180" ColumnSpacing="12" RowSpacing="8">
                                                <Label Text="{Binding Kanal}" VerticalOptions="Center" />
                                                <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                                                    <ctl:ParaGirisi Tutar="{Binding Tutar}" Placeholder="0,00 ₺" />
                                                </Border>
                                            </ctl:UyumluIzgara>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                            <Button Text="Gerçek ödemeyi iptal et" Clicked="OdemeIptalTiklandi" Style="{StaticResource BtnRowDelete}" />
                            <Label Text="İptal bağlı gideri de kaldırır. Yalnız yanlış alış bağlantısı için üstteki taşıma seçeneğini kullanın." Style="{StaticResource LblPageSub}" />
                            <Button Text="Düzeltmeden vazgeç" Command="{Binding DuzeltmedenVazgecCommand}" Style="{StaticResource BtnSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardForm}" IsVisible="{Binding KayitVar}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="BELGELER" Style="{StaticResource LblSection}" />
                            <Label Text="PDF, PNG veya JPEG · en fazla 10 MB. Fatura alışa, dekont belirli ödemeye bağlanabilir." Style="{StaticResource LblPageSub}" />
                            <Button Text="Belgeleri göster / yenile" Command="{Binding BelgeleriYukleCommand}" Style="{StaticResource BtnSecondary}" />
                            <Picker x:Name="BelgeOdemesi" Title="Belgeyi ödemeye bağla (isteğe bağlı)" ItemsSource="{Binding Odemeler}"
                                    ItemDisplayBinding="{Binding Baslik, x:DataType=core:AlisOdemeSatiri}" IsVisible="{Binding EditorMu}" />
                            <Button Text="Belge ekle" Clicked="BelgeEkleTiklandi" />
                            <!-- Kaldırılan belgeler silinmez: editör onları kaldıran, zaman ve gerekçesiyle görebilir. -->
                            <ctl:UyumluSatir Spacing="8" IsVisible="{Binding EditorMu}">
                                <CheckBox IsChecked="{Binding SilinenBelgeleriGoster}" />
                                <Label Text="Kaldırılan belgeleri de göster" VerticalOptions="Center" />
                            </ctl:UyumluSatir>
                            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Belgeler}">
                                <BindableLayout.EmptyView><Label Text="Belgeleri görüntülemek için yenile düğmesini kullanın." Style="{StaticResource LblPageSub}" /></BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate><DataTemplate x:DataType="api:BelgeDto"><VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding DosyaAdi}" FontAttributes="Bold" />
                                    <Label Text="{Binding Yuklendi, StringFormat='Yükleme: {0:dd.MM.yyyy HH:mm}'}" Style="{StaticResource LblPageSub}" />
                                    <Label Text="{Binding ., Converter={StaticResource BelgeAciklamasi}}" Style="{StaticResource LblPageSub}" />
                                    <ctl:UyumluSatir Spacing="8">
                                        <Button Text="Bilgisayara kaydet" Clicked="BelgeIndirTiklandi" CommandParameter="{Binding .}" Style="{StaticResource BtnSecondary}" />
                                        <Button Text="Kaldır" Clicked="BelgeSilTiklandi" CommandParameter="{Binding .}"
                                                IsVisible="{Binding Silindi, Converter={StaticResource TersIse}}"
                                                Style="{StaticResource BtnRowDelete}" />
                                    </ctl:UyumluSatir>
                                </VerticalStackLayout></DataTemplate></BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding EditorMu}" x:Name="AliciHesapAlani">
                        <Border Style="{StaticResource CardForm}" IsVisible="{Binding HesaplarAcik}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="ALICI HESAPLARI" Style="{StaticResource LblSection}" />
                                <Label Text="Her alıcı yalnız kendi alışlarını görür. Şifreyi boş bırakırsanız mevcut şifre korunur." Style="{StaticResource LblPageSub}" />
                                <ctl:UyumluIzgara ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="8">
                                    <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding AliciAd}" Placeholder="Ad soyad" /></Border>
                                    <Border Grid.Column="1" Style="{StaticResource FieldBorder}"><Entry Text="{Binding AliciKullanici}" Placeholder="Kullanıcı adı" /></Border>
                                </ctl:UyumluIzgara>
                                <Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding AliciSifre}" Placeholder="Yeni şifre (en az 8 karakter)" IsPassword="True" /></Border>
                                <ctl:UyumluSatir Spacing="10"><Switch IsToggled="{Binding AliciAktif}" /><Label Text="Hesap aktif" VerticalOptions="Center" /></ctl:UyumluSatir>
                                <ctl:UyumluSatir Spacing="10">
                                    <Button Text="Hesabı kaydet" Command="{Binding AliciKaydetCommand}" />
                                    <Button Text="Yeni hesap" Command="{Binding YeniAliciCommand}" Style="{StaticResource BtnSecondary}" />
                                </ctl:UyumluSatir>
                                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Alicilar}">
                                    <BindableLayout.ItemTemplate><DataTemplate x:DataType="api:AliciDto">
                                        <ctl:UyumluIzgara ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,7" RowSpacing="8">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding Ad}" FontAttributes="Bold" />
                                                <Label Text="{Binding Kullanici}" Style="{StaticResource LblPageSub}" />
                                                <Label Text="Pasif hesap" TextColor="{StaticResource Neg}" FontSize="12" IsVisible="{Binding Aktif, Converter={StaticResource TersIse}}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="Düzenle" Style="{StaticResource BtnSecondary}"
                                                    Command="{Binding BindingContext.AliciDuzenleCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                        </ctl:UyumluIzgara>
                                    </DataTemplate></BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
            </ctl:UyumluBolmeler.Ikinci>
        </ctl:UyumluBolmeler>
    </Grid>
</ContentPage>
