<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · AyarlarPage — yalnız editör. Genel ayar, izleyici şifresi, kanallar, sabit gider kalemleri, tekrarlayan giderler. -->
<ContentPage
    x:Class="Kasa.App.Views.AyarlarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="clr-namespace:Kasa.App.Views"
    x:Name="Sayfa"
    Title="Ayarlar"
    BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Desktop='28,22', Default='16,14'}" Spacing="20"
                             MaximumWidthRequest="1160">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Ayarlar" Style="{StaticResource LblPageTitle}" />
                    <Label Text="Genel ayar, izleyici şifresi, kanallar, sabit gider kalemleri ve tekrarlayan giderler" Style="{StaticResource LblPageSub}" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding Mesgul}" IsVisible="{Binding Mesgul}"
                                   WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
            </Grid>

            <!-- Hata (sayfanın tüm bölümleri için) -->
            <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding Hata, Converter={StaticResource DoluIse}}">
                <Label Text="{Binding Hata}" Style="{StaticResource LblError}" />
            </Border>

            <Grid ColumnDefinitions="{OnIdiom Desktop='*,*', Default='*'}"
                  RowDefinitions="{OnIdiom Desktop='Auto', Default='Auto,Auto'}"
                  ColumnSpacing="20" RowSpacing="20">

                <!-- Genel ayar -->
                <Border Style="{StaticResource CardForm}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Genel Ayar" Style="{StaticResource LblSection}" />
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Takip başlangıcı" Style="{StaticResource LblField}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <DatePicker Date="{Binding TakipBaslangic}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Kasa açılış devri" Style="{StaticResource LblField}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding KasaAcilisDevri, Converter={StaticResource ParaGiris}}" Placeholder="0,00 ₺"
                                       Style="{StaticResource EntryMoney}" />
                            </Border>
                        </VerticalStackLayout>
                        <Button Text="Ayarı kaydet" Command="{Binding AyarKaydetCommand}"
                                HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <!-- İzleyici şifresi -->
                <Border Style="{StaticResource CardForm}"
                        Grid.Column="{OnIdiom Desktop=1, Default=0}"
                        Grid.Row="{OnIdiom Desktop=0, Default=1}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="İzleyici Şifresi" Style="{StaticResource LblSection}" />
                        <Label Text="İzleyici bu şifreyle salt-okunur girer; formlar ve Ayarlar gizlenir."
                               Style="{StaticResource LblPageSub}" />
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Yeni şifre" Style="{StaticResource LblField}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding YeniIzleyiciSifre}" IsPassword="True" Placeholder="••••••••" />
                            </Border>
                        </VerticalStackLayout>
                        <Button Text="Şifreyi kaydet" Command="{Binding IzleyiciSifreKaydetCommand}"
                                HorizontalOptions="Start" />
                        <Label Text="Şifre değişince eski izleyici oturumları kapanır. Bir cihaz kaybolduysa tüm oturumları kapatın."
                               Style="{StaticResource LblPageSub}" />
                        <Button Text="{Binding OturumKapatMetni}" Command="{Binding OturumlariKapatCommand}"
                                Style="{StaticResource BtnRowDelete}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Kanallar -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout Padding="18,18,18,14" Spacing="12">
                        <Label Text="Kanallar" Style="{StaticResource LblSection}" />
                        <Grid ColumnDefinitions="{OnIdiom Desktop='1.4*,90,*,Auto,Auto,Auto', Default='*'}"
                              RowDefinitions="{OnIdiom Desktop='Auto', Default='Auto,Auto,Auto,Auto,Auto,Auto'}"
                              ColumnSpacing="10" RowSpacing="12">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Kanal adı" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding DuzenKanalAd}" Placeholder="Örn. Nakit" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="{OnIdiom Desktop=1, Default=0}"
                                                 Grid.Row="{OnIdiom Desktop=0, Default=1}" Spacing="0">
                                <Label Text="Sıra" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding DuzenKanalSira}" Placeholder="1" Keyboard="Numeric"
                                           HorizontalTextAlignment="End" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="{OnIdiom Desktop=2, Default=0}"
                                                 Grid.Row="{OnIdiom Desktop=0, Default=2}" Spacing="0">
                                <Label Text="Açılış devri" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding DuzenKanalAcilisDevri, Converter={StaticResource ParaGiris}}" Placeholder="0,00 ₺"
                                           Style="{StaticResource EntryMoney}" />
                                </Border>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="{OnIdiom Desktop=3, Default=0}"
                                                   Grid.Row="{OnIdiom Desktop=0, Default=3}"
                                                   Spacing="9" VerticalOptions="End" HeightRequest="44">
                                <Switch IsToggled="{Binding DuzenKanalAktif}" VerticalOptions="Center" />
                                <Label Text="Aktif" Style="{StaticResource LblRowPrimary}" FontSize="13"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Button Text="Kanal kaydet" Command="{Binding KanalKaydetCommand}"
                                    Grid.Column="{OnIdiom Desktop=4, Default=0}"
                                    Grid.Row="{OnIdiom Desktop=0, Default=4}"
                                    Padding="18,0" VerticalOptions="End" />
                            <Button Text="Yeni kanal" Command="{Binding YeniKanalCommand}"
                                    Style="{StaticResource BtnSecondary}"
                                    Grid.Column="{OnIdiom Desktop=5, Default=0}"
                                    Grid.Row="{OnIdiom Desktop=0, Default=5}"
                                    VerticalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Kanal listesi -->
                    <CollectionView ItemsSource="{Binding Kanallar}" SelectionMode="None" Margin="0,4,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <Grid Padding="18,0" HeightRequest="52"
                                          ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="24" HeightRequest="24" StrokeThickness="1"
                                                Stroke="{StaticResource BrushDateChipBorder}"
                                                StrokeShape="RoundRectangle 7" VerticalOptions="Center">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource DateChipBg}" />
                                            </Border.Background>
                                            <Label Text="{Binding Sira}" FontFamily="PlexSansSemiBold" FontSize="12"
                                                   TextColor="{StaticResource Sub}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding Ad}"
                                               Style="{StaticResource LblRowPrimary}" VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center">
                                            <Button Text="Düzenle" Style="{StaticResource BtnRowEdit}"
                                                    Command="{Binding BindingContext.KanalDuzenleCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Sil" Style="{StaticResource BtnRowDelete}"
                                                    Command="{Binding BindingContext.KanalSilCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,30,20,34" Spacing="6">
                                <Label Text="Kanal yok" Style="{StaticResource LblEmptyTitle}" />
                                <Label Text="Yukarıdaki formdan ilk kanalı ekleyin."
                                       Style="{StaticResource LblEmptySub}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Sabit gider kalemleri -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout Padding="18,18,18,14" Spacing="12">
                        <Label Text="Sabit Gider Kalemleri" Style="{StaticResource LblSection}" />
                        <Label Text="Kira, SGK, maaş gibi kalemler. Ad değişince bu kalemle girilmiş eski işlemler de yeni adı alır."
                               Style="{StaticResource LblPageSub}" />
                        <Grid ColumnDefinitions="{OnIdiom Desktop='*,Auto,Auto,Auto', Default='*'}"
                              RowDefinitions="{OnIdiom Desktop='Auto', Default='Auto,Auto,Auto,Auto'}"
                              ColumnSpacing="10" RowSpacing="12">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Kalem adı" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding DuzenKalemAd}" Placeholder="Örn. Kira" />
                                </Border>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="{OnIdiom Desktop=1, Default=0}"
                                                   Grid.Row="{OnIdiom Desktop=0, Default=1}"
                                                   Spacing="9" VerticalOptions="End" HeightRequest="44">
                                <Switch IsToggled="{Binding DuzenKalemAktif}" VerticalOptions="Center" />
                                <Label Text="Aktif" Style="{StaticResource LblRowPrimary}" FontSize="13"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Button Text="Kalem kaydet" Command="{Binding KalemKaydetCommand}"
                                    Grid.Column="{OnIdiom Desktop=2, Default=0}"
                                    Grid.Row="{OnIdiom Desktop=0, Default=2}"
                                    Padding="18,0" VerticalOptions="End" />
                            <Button Text="Yeni kalem" Command="{Binding YeniKalemCommand}"
                                    Style="{StaticResource BtnSecondary}"
                                    Grid.Column="{OnIdiom Desktop=3, Default=0}"
                                    Grid.Row="{OnIdiom Desktop=0, Default=3}"
                                    VerticalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>

                    <CollectionView ItemsSource="{Binding GiderKalemleri}" SelectionMode="None" Margin="0,4,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <Grid Padding="18,0" HeightRequest="52"
                                          ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding Ad}"
                                               Style="{StaticResource LblRowPrimary}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="Pasif" TextColor="{StaticResource Sub}" FontSize="12"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding Aktif, Converter={StaticResource TersIse}}" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                            <Button Text="Düzenle" Style="{StaticResource BtnRowEdit}"
                                                    Command="{Binding BindingContext.KalemDuzenleCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Sil" Style="{StaticResource BtnRowDelete}"
                                                    Command="{Binding BindingContext.KalemSilCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,30,20,34" Spacing="6">
                                <Label Text="Sabit gider kalemi yok" Style="{StaticResource LblEmptyTitle}" />
                                <Label Text="Yukarıdaki formdan ya da İşlemler'de &quot;Kalem olarak ekle&quot; ile ekleyin."
                                       Style="{StaticResource LblEmptySub}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Tekrarlayan giderler -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout Padding="18,18,18,14" Spacing="12">
                        <Label Text="Tekrarlayan Giderler" Style="{StaticResource LblSection}" />
                        <Label Text="Her ay tekrarlanan kira, SGK, maaş gibi giderler. Kendiliğinden işlem girilmez: vadesi gelince Panel'de onayınıza sunulur. Yeni kayıt bu aydan başlar; ayın günü kısa aylarda ayın son gününe düşer."
                               Style="{StaticResource LblPageSub}" />
                        <!-- ==================== Paket D: hazır şablonlar, kart, sıklık, değişken tutar ==================== -->
                        <Border Style="{StaticResource CardForm}" Padding="12,10" IsVisible="{Binding TekrarBilgi, Converter={StaticResource DoluIse}}">
                            <Label Text="{Binding TekrarBilgi}" Style="{StaticResource LblRowPrimary}" TextColor="{StaticResource Pos}"
                                   LineBreakMode="WordWrap" />
                        </Border>
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding HazirVar}">
                            <Label Text="Hazır şablonlar (tutar her seferinde girilir)" Style="{StaticResource LblField}" Margin="0" />
                            <Label Text="Tarihleri muhasebecinizle doğrulayın." Style="{StaticResource LblRowSecondary}" FontSize="12"
                                   TextColor="{StaticResource Neg}" />
                            <FlexLayout Wrap="Wrap" AlignItems="Center" BindableLayout.ItemsSource="{Binding HazirSablonlar}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="0" Margin="0,0,10,8">
                                            <Button Text="{Binding Ad, StringFormat='+ {0}'}" Style="{StaticResource BtnRowEdit}"
                                                    IsEnabled="{Binding Eklendi, Converter={StaticResource TersIse}}"
                                                    Command="{Binding BindingContext.HazirEkleCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            <Label Text="{Binding Aciklama}" Style="{StaticResource LblRowSecondary}" FontSize="11" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Kart (karta bağlı abonelik vb. onaylanınca o kartın harcaması olur)" Style="{StaticResource LblField}" />
                            <FlexLayout Wrap="Wrap" AlignItems="Center"
                                        BindableLayout.ItemsSource="{Binding TekrarKartCipleri}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.SecTekrarKartCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Ad}" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Sıklık" Style="{StaticResource LblField}" />
                            <FlexLayout Wrap="Wrap" AlignItems="Center"
                                        BindableLayout.ItemsSource="{Binding SiklikCipleri}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.SecTekrarSiklikCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Ad}" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                        <FlexLayout Wrap="Wrap" AlignItems="End">
                            <VerticalStackLayout Spacing="0" WidthRequest="200" Margin="0,0,16,0" IsVisible="{Binding BaslangicGorunur}">
                                <Label Text="Başlangıç ayı (ilk vadenin ayı)" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <DatePicker Date="{Binding DuzenTekrarBaslangic}" Format="MMMM yyyy" />
                                </Border>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Spacing="9" HeightRequest="44">
                                <Switch IsToggled="{Binding DuzenTekrarTutarDegisken}" VerticalOptions="Center" />
                                <Label Text="Tutar her seferinde girilir (vergi, fatura)" Style="{StaticResource LblRowPrimary}" FontSize="13"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </FlexLayout>
                        <!-- ==================== /Paket D ==================== -->

                        <VerticalStackLayout Spacing="0">
                            <Label Text="{Binding TekrarKalemEtiketi}" Style="{StaticResource LblField}" />
                            <FlexLayout Wrap="Wrap" AlignItems="Center"
                                        BindableLayout.ItemsSource="{Binding TekrarKalemCipleri}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.SecTekrarKalemCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Ad}" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Label Text="{Binding TekrarKalemYokMetni}"
                                   Style="{StaticResource LblPageSub}"
                                   IsVisible="{Binding TekrarKalemYok}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Kanal" Style="{StaticResource LblField}" />
                            <FlexLayout Wrap="Wrap" AlignItems="Center"
                                        BindableLayout.ItemsSource="{Binding TekrarKanalCipleri}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.SecTekrarKanalCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Ad}" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="{OnIdiom Desktop='*,110,Auto,Auto,Auto', Default='*'}"
                              RowDefinitions="{OnIdiom Desktop='Auto', Default='Auto,Auto,Auto,Auto,Auto'}"
                              ColumnSpacing="10" RowSpacing="12">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="{Binding TekrarTutarEtiketi}" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding DuzenTekrarTutar, Converter={StaticResource ParaGiris}}" Placeholder="0,00 ₺"
                                           Style="{StaticResource EntryMoney}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="{OnIdiom Desktop=1, Default=0}"
                                                 Grid.Row="{OnIdiom Desktop=0, Default=1}" Spacing="0">
                                <Label Text="Ayın günü" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding DuzenTekrarGun}" Placeholder="1–31" Keyboard="Numeric"
                                           HorizontalTextAlignment="End" />
                                </Border>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="{OnIdiom Desktop=2, Default=0}"
                                                   Grid.Row="{OnIdiom Desktop=0, Default=2}"
                                                   Spacing="9" VerticalOptions="End" HeightRequest="44">
                                <Switch IsToggled="{Binding DuzenTekrarAktif}" VerticalOptions="Center" />
                                <Label Text="Aktif" Style="{StaticResource LblRowPrimary}" FontSize="13"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Button Text="Gideri kaydet" Command="{Binding TekrarKaydetCommand}"
                                    Grid.Column="{OnIdiom Desktop=3, Default=0}"
                                    Grid.Row="{OnIdiom Desktop=0, Default=3}"
                                    Padding="18,0" VerticalOptions="End" />
                            <Button Text="Yeni gider" Command="{Binding YeniTekrarCommand}"
                                    Style="{StaticResource BtnSecondary}"
                                    Grid.Column="{OnIdiom Desktop=4, Default=0}"
                                    Grid.Row="{OnIdiom Desktop=0, Default=4}"
                                    VerticalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>

                    <CollectionView ItemsSource="{Binding TekrarlayanGiderler}" SelectionMode="None" Margin="0,4,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <Grid Padding="18,8" MinimumHeightRequest="52"
                                          ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Kalem}" Style="{StaticResource LblRowPrimary}" />
                                            <Label Text="{Binding Aciklama}" Style="{StaticResource LblRowSecondary}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="Pasif" TextColor="{StaticResource Sub}" FontSize="12"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding Aktif, Converter={StaticResource TersIse}}" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                            <Button Text="Düzenle" Style="{StaticResource BtnRowEdit}"
                                                    Command="{Binding BindingContext.TekrarDuzenleCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Sil" Style="{StaticResource BtnRowDelete}"
                                                    Command="{Binding BindingContext.TekrarSilCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,30,20,34" Spacing="6">
                                <Label Text="Tekrarlayan gider yok" Style="{StaticResource LblEmptyTitle}" />
                                <Label Text="Kalem, kanal, tutar ve ayın gününü seçip Gideri kaydet'e basın."
                                       Style="{StaticResource LblEmptySub}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- ═══ BÖLÜM · Paket A · Bildirimler (bu bilgisayar; sunucu ayarı değildir) ═══ -->
            <v:BildirimAyarlariView />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
