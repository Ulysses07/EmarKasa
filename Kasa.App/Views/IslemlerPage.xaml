<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · IslemlerPage — solda editör form sütunu, sağda işlem listesi. -->
<ContentPage
    x:Class="Kasa.App.Views.IslemlerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Sayfa"
    Title="İşlemler"
    BackgroundColor="{StaticResource AppBg}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="{OnIdiom Desktop='28,22', Default='16,14'}"
          RowSpacing="16" MaximumWidthRequest="1160">

        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="3">
                <Label Text="İşlemler" Style="{StaticResource LblPageTitle}" />
                <Label Text="Ödeme ve kanal geliri kayıtları" Style="{StaticResource LblPageSub}" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding Mesgul}" IsVisible="{Binding Mesgul}"
                               WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
        </Grid>

        <!-- Hata (tüm roller; editör formunun dışında) -->
        <Border Grid.Row="1" Style="{StaticResource ErrorBox}"
                IsVisible="{Binding Hata, Converter={StaticResource DoluIse}}">
            <Label Text="{Binding Hata}" Style="{StaticResource LblError}" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="20">

            <!-- SOL: editör form sütunu -->
            <ScrollView IsVisible="{Binding EditorMu}" VerticalOptions="Fill">
                <VerticalStackLayout WidthRequest="360" Spacing="16">

                    <!-- Bölüm 1 · İşlem -->
                    <Border Style="{StaticResource CardForm}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="İşlem" Style="{StaticResource LblSection}" />
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Tarih" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <DatePicker Date="{Binding DuzenTarih}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="0">
                                <!-- Tip "Sabit gider" iken ad, Cariler yerine sabit gider kalemleri listesinden seçilir -->
                                <Label Text="{Binding AdEtiketi}" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding DuzenCari}" Placeholder="Adı yazın, listeden seçin" />
                                </Border>
                                <Button Text="Kalem olarak ekle" Command="{Binding KalemEkleCommand}"
                                        Style="{StaticResource BtnSecondary}" HorizontalOptions="Start"
                                        Margin="0,8,0,0" IsVisible="{Binding KalemEklenebilir}" />
                                <!-- Yazılana uyan kayıtlı cariler: dokununca seçilir (kayıtsız cariyle işlem girilemez) -->
                                <FlexLayout Wrap="Wrap" AlignItems="Center" Margin="0,8,0,0"
                                            IsVisible="{Binding CariOnerileriGorunur}"
                                            BindableLayout.ItemsSource="{Binding CariOnerileri}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding BindingContext.SecCariCommand, Source={x:Reference Sayfa}}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding .}" Style="{StaticResource ChipText}" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Tutar" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding DuzenTutar, Converter={StaticResource ParaGiris}}" Placeholder="0,00 ₺"
                                           Style="{StaticResource EntryMoney}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Kanal" Style="{StaticResource LblField}" />
                                <FlexLayout Wrap="Wrap" AlignItems="Center"
                                            BindableLayout.ItemsSource="{Binding GiderKanallari}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding BindingContext.SecGiderKanalCommand, Source={x:Reference Sayfa}}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding Ad}" Style="{StaticResource ChipText}" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Tip" Style="{StaticResource LblField}" />
                                <FlexLayout Wrap="Wrap" AlignItems="Center"
                                            BindableLayout.ItemsSource="{Binding TipCipleri}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding BindingContext.SecTipCommand, Source={x:Reference Sayfa}}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding Ad}" Style="{StaticResource ChipText}" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="0" IsVisible="{Binding KartSeciciGorunur}">
                                <Label Text="Kart (zorunlu)" Style="{StaticResource LblField}" />
                                <Label Text="Henüz kart yok. Önce Kredi Kartları sayfasından kart ekleyin."
                                       Style="{StaticResource LblRowSecondary}" FontSize="12" Margin="0,0,0,6"
                                       IsVisible="{Binding KartYok}" />
                                <FlexLayout Wrap="Wrap" AlignItems="Center"
                                            BindableLayout.ItemsSource="{Binding KartCipleri}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding BindingContext.SecKartCommand, Source={x:Reference Sayfa}}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding Ad}" Style="{StaticResource ChipText}" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Not" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding DuzenNot}" Placeholder="İsteğe bağlı" />
                                </Border>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2,0,0">
                                <Button Text="Kaydet" Command="{Binding KaydetCommand}" />
                                <Button Grid.Column="1" Text="Yeni" Command="{Binding YeniCommand}"
                                        Style="{StaticResource BtnSecondary}" />
                            </Grid>
                            <!-- İleri tarihli işlem onayı -->
                            <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding IleriTarihOnayBekliyor}">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="{Binding IleriTarihUyarisi}" Style="{StaticResource LblError}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Yine de kaydet" Command="{Binding IleriTarihOnaylaCommand}"
                                                Style="{StaticResource BtnRowDelete}" />
                                        <Button Text="Vazgeç" Command="{Binding IleriTarihVazgecCommand}"
                                                Style="{StaticResource BtnSecondary}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Bölüm 2 · Gelen (kanal geliri) -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <VerticalStackLayout Spacing="0">
                            <BoxView HeightRequest="3" Color="{StaticResource Green}" />
                            <VerticalStackLayout Padding="18" Spacing="12">
                                <Label Text="Gelen · Kanal Geliri" Style="{StaticResource LblSection}"
                                       TextColor="{StaticResource Green}" />
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Tarih" Style="{StaticResource LblField}" />
                                    <Border Style="{StaticResource FieldBorder}">
                                        <DatePicker Date="{Binding GelenTarih}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Kanal" Style="{StaticResource LblField}" />
                                    <FlexLayout Wrap="Wrap" AlignItems="Center"
                                                BindableLayout.ItemsSource="{Binding GelenKanallari}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.SecGelenKanalCommand, Source={x:Reference Sayfa}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="{Binding Ad}" Style="{StaticResource ChipText}" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="Tutar" Style="{StaticResource LblField}" />
                                    <Border Style="{StaticResource FieldBorder}">
                                        <Entry Text="{Binding GelenTutar, Converter={StaticResource ParaGiris}}" Placeholder="0,00 ₺"
                                               Style="{StaticResource EntryMoney}" />
                                    </Border>
                                </VerticalStackLayout>
                                <Button Text="Gelen kaydet" Command="{Binding GelenKaydetCommand}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- SAĞ: işlem listesi -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid RowDefinitions="Auto,*">
                    <VerticalStackLayout Padding="18,16,18,12" Spacing="10">
                        <Label Text="Son İşlemler" Style="{StaticResource LblSection}" />

                        <!-- Filtre: kanal çipleri -->
                        <FlexLayout Wrap="Wrap" AlignItems="Center"
                                    BindableLayout.ItemsSource="{Binding FiltreKanallari}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.SecFiltreKanalCommand, Source={x:Reference Sayfa}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Ad}" Style="{StaticResource ChipText}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- Filtre: zaman çipleri + dönem seçici -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <FlexLayout Wrap="Wrap" AlignItems="Center"
                                        BindableLayout.ItemsSource="{Binding FiltreZamanlar}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.SecFiltreZamanCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Ad}" Style="{StaticResource ChipText}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Border Grid.Column="1" Style="{StaticResource FieldBorder}"
                                    MinimumWidthRequest="150" MinimumHeightRequest="38">
                                <Picker ItemsSource="{Binding FiltreDonemler}"
                                        SelectedItem="{Binding SeciliDonem}"
                                        ItemDisplayBinding="{Binding ., Converter={StaticResource DonemBicim}}"
                                        Title="Hafta seç" />
                            </Border>
                        </Grid>

                        <!-- Özet + Excel'e aktar (seçili filtreye uyan tüm işlemler, yüklenmemiş eskiler dahil) -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding FiltreOzet}" Style="{StaticResource LblRowSecondary}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Excel'e aktar" Command="{Binding ExceleAktarCommand}"
                                    Style="{StaticResource BtnSecondary}" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding AktarilanDosya, StringFormat='Kaydedildi: {0}'}" Style="{StaticResource LblRowSecondary}"
                               TextColor="{StaticResource Pos}" LineBreakMode="CharacterWrap"
                               IsVisible="{Binding AktarilanDosya, Converter={StaticResource DoluIse}}" />
                        <!-- Rapordan gelinen tip süzgeci (liste yalnız bu tipi gösterir) -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding TipSuzgeciVar}">
                            <Label Text="{Binding TipSuzgeciMetni}" Style="{StaticResource LblRowSecondary}"
                                   TextColor="{StaticResource Green}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Tüm tipler" Command="{Binding TipSuzgeciniKaldirCommand}"
                                    Style="{StaticResource BtnRowEdit}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding Islemler}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <Grid Padding="18,6" MinimumHeightRequest="58"
                                          ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                                        <Border Style="{StaticResource DateChip}" VerticalOptions="Center">
                                            <Label Text="{Binding Tarih, StringFormat='{0:dd MMM}'}"
                                                   Style="{StaticResource LblDateChip}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Cari}" Style="{StaticResource LblRowPrimary}" />
                                            <Label Text="{Binding Kanal}" Style="{StaticResource LblRowSecondary}" />
                                        </VerticalStackLayout>
                                        <!-- İşlem her zaman giderdir: kırmızı (gelir yeşil, gider kırmızı) -->
                                        <Label Grid.Column="2"
                                               Text="{Binding TutarTl, Converter={StaticResource ParaBicim}, StringFormat='−{0}'}"
                                               Style="{StaticResource LblMoney}"
                                               TextColor="{StaticResource Neg}"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center"
                                                               IsVisible="{Binding BindingContext.EditorMu, Source={x:Reference Sayfa}}">
                                            <Button Text="Düzenle" Style="{StaticResource BtnRowEdit}"
                                                    Command="{Binding BindingContext.DuzenleCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Sil" Style="{StaticResource BtnRowDelete}"
                                                    Command="{Binding BindingContext.SilCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,36,20,40" Spacing="6">
                                <Border Style="{StaticResource AvatarChip}" WidthRequest="40" HeightRequest="40"
                                        StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                    <Label Text="₺" Style="{StaticResource LblAvatar}" FontSize="17" />
                                </Border>
                                <Label Text="Henüz işlem yok" Style="{StaticResource LblEmptyTitle}" Margin="0,4,0,0" />
                                <Label Text="İlk kayıtla liste burada oluşur."
                                       Style="{StaticResource LblEmptySub}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <!-- Liste sayfalı: en yeni işlemler önce, eskiler istenince eklenir -->
                        <CollectionView.Footer>
                            <VerticalStackLayout Padding="18,12"
                                                 IsVisible="{Binding BindingContext.DahaEskiVar, Source={x:Reference Sayfa}}">
                                <Button Text="Daha eski işlemleri göster"
                                        Style="{StaticResource BtnSecondary}" HorizontalOptions="Center"
                                        Command="{Binding BindingContext.DahaEskiYukleCommand, Source={x:Reference Sayfa}}" />
                            </VerticalStackLayout>
                        </CollectionView.Footer>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
