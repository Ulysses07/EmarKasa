<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · HaftalikPage — dönem listesi, sağa hizalı kasa sonucu. -->
<ContentPage
    x:Class="Kasa.App.Views.HaftalikPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:Kasa.App.Core;assembly=Kasa.App.Core"
    x:Name="Sayfa"
    Title="Haftalık"
    BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Desktop='28,22', Default='16,14'}" Spacing="20"
                             MaximumWidthRequest="1160">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Haftalık" Style="{StaticResource LblPageTitle}" />
                    <Label Text="Dönem bazlı kasa sonuçları" Style="{StaticResource LblPageSub}" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding Mesgul}" IsVisible="{Binding Mesgul}"
                                   WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                <!-- Tüm dönemler × kanallar + kasa satırları; Belgeler\Emar Kasa'ya kaydedilir ve açılır -->
                <Button Grid.Column="2" Text="Excel'e aktar" Command="{Binding ExceleAktarCommand}"
                        Style="{StaticResource BtnSecondary}" VerticalOptions="Center" />
            </Grid>

            <!-- Hata (tüm roller) -->
            <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding Hata, Converter={StaticResource DoluIse}}">
                <Label Text="{Binding Hata}" Style="{StaticResource LblError}" />
            </Border>

            <!-- Son aktarılan dosya -->
            <Label Text="{Binding AktarilanDosya, StringFormat='Kaydedildi: {0}'}" Style="{StaticResource LblRowSecondary}"
                   TextColor="{StaticResource Pos}" LineBreakMode="CharacterWrap"
                   IsVisible="{Binding AktarilanDosya, Converter={StaticResource DoluIse}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="18,16,18,12" ColumnDefinitions="*,Auto">
                        <Label Text="Dönem" Style="{StaticResource LblSection}" />
                        <Label Grid.Column="1" Text="Kasa Sonucu" Style="{StaticResource LblSection}" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding Donemler}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <Grid Padding="18,0" HeightRequest="54"
                                          ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource DateChip}" VerticalOptions="Center">
                                            <Label Text="{Binding Donem.Start, StringFormat='{0:dd MMM}'}"
                                                   Style="{StaticResource LblDateChip}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Style="{StaticResource LblRowPrimary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Donem.Ay, Converter={StaticResource AyAdi}}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding Donem.Yil}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Style="{StaticResource LblRowSecondary}" FontSize="12">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Donem.Start, StringFormat='{0:dd MMM}'}" />
                                                        <Span Text=" – " />
                                                        <Span Text="{Binding Donem.End, StringFormat='{0:dd MMM}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <!-- Haftaya soru (her iki rol; paket E) -->
                                        <Button Grid.Column="1" Text="Soru sor" Style="{StaticResource BtnRowEdit}"
                                                HorizontalOptions="End" VerticalOptions="Center"
                                                Command="{x:Static core:SoruYonlendirme.SorKomutu}" CommandParameter="{Binding .}" />
                                        <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                            <Label HorizontalOptions="End"
                                                   Text="{Binding KasaSonucu, Converter={StaticResource ParaBicim}}"
                                                   Style="{StaticResource LblMoney}"
                                                   TextColor="{Binding KasaSonucu, Converter={StaticResource ParaRenk}}" />
                                            <!-- Çek hareketi varsa (tahsil edilen / ödenen): sonuca dahil, ayrıca gösterilir -->
                                            <Label HorizontalOptions="End" FontSize="11" TextColor="{StaticResource Sub}"
                                                   IsVisible="{Binding CekVar}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Çek +" />
                                                        <Span Text="{Binding ToplamCekGelen, Converter={StaticResource ParaBicim}}" />
                                                        <Span Text=" / −" />
                                                        <Span Text="{Binding ToplamCekGiden, Converter={StaticResource ParaBicim}}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,36,20,40" Spacing="6">
                                <Border Style="{StaticResource AvatarChip}" WidthRequest="40" HeightRequest="40"
                                        StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                    <Label Text="₺" Style="{StaticResource LblAvatar}" FontSize="17" />
                                </Border>
                                <Label Text="Kayıtlı dönem yok" Style="{StaticResource LblEmptyTitle}" Margin="0,4,0,0" />
                                <Label Text="İşlem girdikçe haftalık sonuçlar burada birikir."
                                       Style="{StaticResource LblEmptySub}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
