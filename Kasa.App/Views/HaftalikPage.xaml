<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · HaftalikPage — dönem listesi, sağa hizalı kasa sonucu. -->
<ContentPage
    x:Class="Kasa.App.Views.HaftalikPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Sayfa"
    Title="Haftalık"
    BackgroundColor="{StaticResource AppBg}">

    <ScrollView x:Name="Kaydirma">
        <VerticalStackLayout Padding="{OnIdiom Desktop='28,22', Default='16,14'}" Spacing="20"
                             MaximumWidthRequest="1160">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Haftalık" Style="{StaticResource LblPageTitle}" />
                    <Label Text="Dönem bazlı kasa sonuçları" Style="{StaticResource LblPageSub}" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding Mesgul}" IsVisible="{Binding Mesgul}"
                                   WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                <!-- Tüm dönemler × kanallar + kasa satırları; Belgeler\Emar Kasa'ya kaydedilir ve açılır -->
                <Button Grid.Column="2" Text="Excel'e aktar" Command="{Binding ExceleAktarCommand}"
                        Style="{StaticResource BtnSecondary}" VerticalOptions="Center" />
            </Grid>

            <!-- Hata (tüm roller) -->
            <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding Hata, Converter={StaticResource DoluIse}}">
                <Label Text="{Binding Hata}" Style="{StaticResource LblError}" />
            </Border>

            <!-- Son aktarılan dosya -->
            <Label Text="{Binding AktarilanDosya, StringFormat='Kaydedildi: {0}'}" Style="{StaticResource LblRowSecondary}"
                   TextColor="{StaticResource Pos}" LineBreakMode="CharacterWrap"
                   IsVisible="{Binding AktarilanDosya, Converter={StaticResource DoluIse}}" />

            <!-- Paket B · Seçili dönem: kanal rakamları (İşlemler'e iner) ve "Kasa neden değişti?" -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding DetayVar}">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="18,16,18,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding DetayBaslik}" Style="{StaticResource LblSection}" />
                            <Label Text="{Binding DetayOzeti}" Style="{StaticResource LblRowSecondary}"
                                   IsVisible="{Binding DetayOzeti, Converter={StaticResource DoluIse}}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Ayrıntı" Command="{Binding KasaDokumunuAcCommand}"
                                Style="{StaticResource BtnRowEdit}" VerticalOptions="Start" />
                        <Button Grid.Column="2" Text="Kapat" Command="{Binding DonemSecCommand}"
                                Style="{StaticResource BtnSecondary}" HeightRequest="32" VerticalOptions="Start" />
                    </Grid>
                    <!-- Kanal satırları: dokununca o kanalın bu dönemdeki işlemleri -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DetayKanallari}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <Grid Padding="18,0" HeightRequest="44" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.IslemlereGitCommand, Source={x:Reference Sayfa}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Label Text="{Binding Kanal}" Style="{StaticResource LblRowPrimary}" VerticalOptions="Center" />
                                            <Label Text="İşlemler ›" TextColor="{StaticResource Green}" FontSize="12" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding GelenMetni, StringFormat='Gelen {0}'}" Style="{StaticResource LblRowSecondary}"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding GidenMetni, StringFormat='Giden {0}'}" Style="{StaticResource LblRowSecondary}"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="3" Text="{Binding Sonuc, Converter={StaticResource ParaBicim}}" Style="{StaticResource LblMoney}"
                                               TextColor="{Binding Sonuc, Converter={StaticResource ParaRenk}}" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <!-- Kasa dökümü: açılış → adımlar → kapanış (gider satırı İşlemler'e iner) -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DetayAdimlari}" Margin="0,8,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <Grid Padding="18,0" HeightRequest="40" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.IslemlereGitCommand, Source={x:Reference Sayfa}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding Etiket}" Style="{StaticResource LblRowSecondary}" VerticalOptions="Center" />
                                            <Label Text="›" TextColor="{StaticResource Green}" FontSize="15" VerticalOptions="Center"
                                                   IsVisible="{Binding Inilebilir}" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding TutarMetni}" Style="{StaticResource LblMoney}" FontSize="13"
                                               WidthRequest="130" HorizontalTextAlignment="End" VerticalOptions="Center"
                                               TextColor="{Binding RenkDegeri, Converter={StaticResource ParaRenk}}" />
                                        <Label Grid.Column="2" Text="{Binding BakiyeMetni}" Style="{StaticResource LblRowSecondary}"
                                               WidthRequest="130" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="18,16,18,12" ColumnDefinitions="*,Auto">
                        <Label Text="Dönem" Style="{StaticResource LblSection}" />
                        <Label Grid.Column="1" Text="Kasa Sonucu" Style="{StaticResource LblSection}" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding Donemler}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <Grid Padding="18,0" HeightRequest="54"
                                          ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <!-- Döneme dokununca üstte ayrıntısı açılır ve sayfa ona kayar (yeniden dokununca kapanır, liste konumuna dönülür) -->
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.DonemSecCommand, Source={x:Reference Sayfa}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Border Style="{StaticResource DateChip}" VerticalOptions="Center">
                                            <Label Text="{Binding Donem.Start, StringFormat='{0:dd MMM}'}"
                                                   Style="{StaticResource LblDateChip}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Style="{StaticResource LblRowPrimary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Donem.Ay, Converter={StaticResource AyAdi}}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding Donem.Yil}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Style="{StaticResource LblRowSecondary}" FontSize="12">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Donem.Start, StringFormat='{0:dd MMM}'}" />
                                                        <Span Text=" – " />
                                                        <Span Text="{Binding Donem.End, StringFormat='{0:dd MMM}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                            <Label HorizontalOptions="End"
                                                   Text="{Binding KasaSonucu, Converter={StaticResource ParaBicim}}"
                                                   Style="{StaticResource LblMoney}"
                                                   TextColor="{Binding KasaSonucu, Converter={StaticResource ParaRenk}}" />
                                            <!-- Çek hareketi varsa (tahsil edilen / ödenen): sonuca dahil, ayrıca gösterilir -->
                                            <Label HorizontalOptions="End" FontSize="11" TextColor="{StaticResource Sub}"
                                                   IsVisible="{Binding CekVar}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Çek +" />
                                                        <Span Text="{Binding ToplamCekGelen, Converter={StaticResource ParaBicim}}" />
                                                        <Span Text=" / −" />
                                                        <Span Text="{Binding ToplamCekGiden, Converter={StaticResource ParaBicim}}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,36,20,40" Spacing="6">
                                <Border Style="{StaticResource AvatarChip}" WidthRequest="40" HeightRequest="40"
                                        StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                    <Label Text="₺" Style="{StaticResource LblAvatar}" FontSize="17" />
                                </Border>
                                <Label Text="Kayıtlı dönem yok" Style="{StaticResource LblEmptyTitle}" Margin="0,4,0,0" />
                                <Label Text="İşlem girdikçe haftalık sonuçlar burada birikir."
                                       Style="{StaticResource LblEmptySub}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
