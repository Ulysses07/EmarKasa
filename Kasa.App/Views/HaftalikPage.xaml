<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · HaftalikPage — dönem listesi, sağa hizalı kasa sonucu. -->
<ContentPage
    x:Class="Kasa.App.Views.HaftalikPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:Kasa.App.Controls"
    xmlns:core="clr-namespace:Kasa.App.Core;assembly=Kasa.App.Core"
    x:DataType="core:HaftalikViewModel"
    x:Name="Sayfa"
    Title="Haftalık"
    BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Desktop='28,22', Default='16,14'}" Spacing="20"
                             MaximumWidthRequest="1160">
            <VerticalStackLayout Spacing="3">
                <Label Text="Haftalık" Style="{StaticResource LblPageTitle}" />
                <Label Text="Dönem bazlı kasa sonuçları" Style="{StaticResource LblPageSub}" />
            </VerticalStackLayout>

            <ctl:DurumSeridi Mesgul="{Binding Mesgul}" Hata="{Binding Hata}"
                             SonGuncellemeMetni="{Binding SonGuncellemeMetni}" YenileCommand="{Binding YenileCommand}" />

            <!-- Sunucunun veri sağlığı uyarısı (ör. rapor ufkunun ötesinde tarihli kayıt): dönem listesinden ayrı ve öne çıkar. -->
            <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding VeriSagligiUyarisi, Converter={StaticResource DoluIse}}">
                <Label Text="{Binding VeriSagligiUyarisi}" Style="{StaticResource LblError}" />
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding VeriVar}">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="18,16,18,12" ColumnDefinitions="*,Auto">
                        <Label Text="DÖNEM" Style="{StaticResource LblSection}" />
                        <Label Grid.Column="1" Text="KASA SONUCU" Style="{StaticResource LblSection}" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding Donemler}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="core:HaftalikSatir">
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <!-- Yalnız dağılım bekleyen tutar sıfırdan farklıyken; metin satır modelinde (Bicim.Tl). -->
                                    <Label Text="{Binding DagilimBekleyenMetni}" IsVisible="{Binding DagilimBekliyor}" TextColor="{StaticResource UyariMetin}" FontSize="12" Margin="18,5,18,0" />
                                    <Grid Padding="18,0" HeightRequest="54"
                                          ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource DateChip}" VerticalOptions="Center">
                                            <Label Text="{Binding Donem.Start, StringFormat='{0:dd MMM}'}"
                                                   Style="{StaticResource LblDateChip}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Style="{StaticResource LblRowPrimary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Donem.Ay, Converter={StaticResource AyAdi}}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding Donem.Yil}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Style="{StaticResource LblRowSecondary}" FontSize="12">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Donem.Start, StringFormat='{0:dd MMM}'}" />
                                                        <Span Text=" – " />
                                                        <Span Text="{Binding Donem.End, StringFormat='{0:dd MMM}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding KasaSonucu, Converter={StaticResource ParaBicim}}"
                                               Style="{StaticResource LblMoney}"
                                               TextColor="{Binding KasaSonucu, Converter={StaticResource ParaRenk}}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <ctl:BosDurum Baslik="Kayıtlı dönem yok"
                                          Aciklama="İşlem girdikçe haftalık sonuçlar burada birikir." />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
