<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · LoginPage — flyout gizli, marka kimliği merkezde. -->
<ContentPage
    x:Class="Kasa.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Sayfa"
    Title="Giriş"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                             WidthRequest="380" Padding="0,40" Spacing="0">

            <!-- Logo + başlık -->
            <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0"
                    StrokeShape="RoundRectangle 13" Background="{StaticResource BrushGreen}"
                    HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#1E5F46" Opacity="0.25" Radius="14" Offset="0,6" />
                </Border.Shadow>
                <Label Text="₺" TextColor="White" FontFamily="PlexSansBold" FontSize="22"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="Emar Kasa" FontFamily="PlexSansBold" FontSize="24"
                   TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" Margin="0,14,0,0" />
            <Label Text="Kasa defteri · nakit akışı takibi" Style="{StaticResource LblPageSub}"
                   FontSize="13" HorizontalTextAlignment="Center" Margin="0,4,0,0" />

            <!-- Çevrimdışı açılış: kayıtlı oturum doğrulanamadı (ağ yok / sunucu kapalı) -->
            <Border Style="{StaticResource Card}" Padding="26,26,26,24" Margin="0,26,0,0"
                    IsVisible="{Binding Cevrimdisi}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Sunucuya ulaşılamadı" FontFamily="PlexSansSemiBold" FontSize="16"
                           TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
                    <Label Text="İnternet bağlantınızı kontrol edip tekrar deneyin. Oturumunuz bu cihazda kayıtlı; bağlantı gelince giriş yapmanız gerekmez."
                           Style="{StaticResource LblRowSecondary}" HorizontalTextAlignment="Center" />
                    <Button Text="Tekrar dene" Command="{Binding TekrarDeneCommand}"
                            IsEnabled="{Binding Mesgul, Converter={StaticResource TersIse}}" />
                    <ActivityIndicator IsRunning="{Binding Mesgul}" IsVisible="{Binding Mesgul}"
                                       WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" />
                    <Button Text="Farklı kullanıcıyla giriş yap" Command="{Binding GirisFormunaGecCommand}"
                            Style="{StaticResource BtnSecondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Giriş kartı -->
            <Border Style="{StaticResource Card}" Padding="26,26,26,24" Margin="0,26,0,0"
                    IsVisible="{Binding Cevrimdisi, Converter={StaticResource TersIse}}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Kullanıcı" Style="{StaticResource LblField}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding Kullanici}" Placeholder="kullanıcı adı" />
                    </Border>

                    <Label Text="Şifre" Style="{StaticResource LblField}" Margin="0,14,0,6" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding Sifre}" IsPassword="True" Placeholder="••••••••"
                               ReturnCommand="{Binding GirisCommand}" />
                    </Border>

                    <!-- İki adımlı giriş: şifre doğru, hesapta kod açık (paket E) -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding KodGerekli}">
                        <Label Text="Doğrulama kodu" Style="{StaticResource LblField}" Margin="0,14,0,6" />
                        <Label Text="{Binding KodBilgisi}" Style="{StaticResource LblRowSecondary}" FontSize="12" Margin="0,0,0,6" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Kod}" Placeholder="123456 ya da kurtarma kodu"
                                   ReturnCommand="{Binding GirisCommand}" />
                        </Border>
                        <Label Text="Telefon yanınızda değilse kurtarma kodlarınızdan birini yazın."
                               Style="{StaticResource LblRowSecondary}" FontSize="12" Margin="0,6,0,0" />
                        <Button Text="Başka hesapla gir" Command="{Binding KodIptalCommand}"
                                Style="{StaticResource BtnSecondary}" Margin="0,10,0,0" />
                    </VerticalStackLayout>

                    <!-- Hata -->
                    <Border Style="{StaticResource ErrorBox}" Margin="0,16,0,0"
                            IsVisible="{Binding Hata, Converter={StaticResource DoluIse}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <Border WidthRequest="16" HeightRequest="16" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5" VerticalOptions="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource Neg}" />
                                </Border.Background>
                                <Label Text="!" TextColor="White" FontFamily="PlexSansBold" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding Hata}" Style="{StaticResource LblError}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Giriş + yükleniyor -->
                    <Button Text="Giriş" Command="{Binding GirisCommand}" Margin="0,16,0,0"
                            IsEnabled="{Binding Mesgul, Converter={StaticResource TersIse}}" />
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,12,0,0"
                                           IsVisible="{Binding Mesgul}">
                        <ActivityIndicator IsRunning="{Binding Mesgul}" WidthRequest="16" HeightRequest="16" />
                        <Label Text="Giriş yapılıyor…" Style="{StaticResource LblRowSecondary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Kendi kullanıcı adınız ve şifrenizle girin. Ortak izleyici şifresi de geçerlidir."
                   Style="{StaticResource LblRowSecondary}" FontSize="12"
                   HorizontalTextAlignment="Center" Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
