<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · LoginPage — flyout gizli, marka kimliği merkezde. -->
<ContentPage
    x:Class="Kasa.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:Kasa.App.Core;assembly=Kasa.App.Core"
    x:DataType="core:AuthViewModel"
    x:Name="Sayfa"
    Title="Giriş"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                             WidthRequest="380" Padding="0,40" Spacing="0">

            <!-- Logo + başlık -->
            <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0"
                    StrokeShape="RoundRectangle 13" Background="{StaticResource BrushGreen}"
                    HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BrushGreen}" Opacity="0.25" Radius="14" Offset="0,6" />
                </Border.Shadow>
                <Label Text="₺" TextColor="White" FontAttributes="Bold" FontSize="22"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="Emar Kasa" FontAttributes="Bold" FontSize="24"
                   TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" Margin="0,14,0,0" />
            <Label Text="Kasa defteri · nakit akışı takibi" Style="{StaticResource LblPageSub}"
                   FontSize="13" HorizontalTextAlignment="Center" Margin="0,4,0,0" />

            <!-- Giriş kartı -->
            <Border Style="{StaticResource Card}" Padding="26,26,26,24" Margin="0,26,0,0">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Kullanıcı" Style="{StaticResource LblField}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding Kullanici}" Placeholder="Editör veya alıcı kullanıcı adı"
                               SemanticProperties.Description="Kullanıcı" />
                    </Border>

                    <Label Text="Şifre" Style="{StaticResource LblField}" Margin="0,14,0,6" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry Text="{Binding Sifre}" IsPassword="True" Placeholder="••••••••"
                               SemanticProperties.Description="Şifre" />
                    </Border>

                    <!-- Hata -->
                    <Border Style="{StaticResource ErrorBox}" Margin="0,16,0,0"
                            IsVisible="{Binding Hata, Converter={StaticResource DoluIse}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <Border WidthRequest="16" HeightRequest="16" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5" VerticalOptions="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource Neg}" />
                                </Border.Background>
                                <Label Text="!" TextColor="White" FontAttributes="Bold" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding Hata}" Style="{StaticResource LblError}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Giriş + yükleniyor -->
                    <Button Text="Giriş" Command="{Binding GirisCommand}" Margin="0,16,0,0"
                            IsEnabled="{Binding Mesgul, Converter={StaticResource TersIse}}" />
                    <Button Text="Şifremi unuttum" Command="{Binding KurtarmayiAcKapatCommand}" Style="{StaticResource BtnSecondary}" Margin="0,10,0,0" />
                    <VerticalStackLayout IsVisible="{Binding KurtarmaAcik}" Spacing="10" Margin="0,14,0,0">
                        <Label Text="Editör hesabınızın daha önce oluşturduğunuz tek kullanımlık kurtarma kodunu girin. Alıcı hesabı için editörünüzle görüşün." Style="{StaticResource LblPageSub}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding KurtarmaKodu}" Placeholder="Kurtarma kodu" IsPassword="True"
                                   SemanticProperties.Description="Kurtarma kodu" />
                        </Border>
                        <!-- "Yeni şifreyi göster" yalnız yeni şifre alanlarını açar (kurtarma kodu maskeli kalır); durum görünüm
                             modelindedir, form kapanınca, başarıda ve oturum değişiminde kapanır. -->
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding KurtarmaYeniSifre}" Placeholder="Yeni şifre (en az 12 karakter)"
                                   IsPassword="{Binding KurtarmaSifresiniGoster, Converter={StaticResource TersIse}}"
                                   SemanticProperties.Description="Yeni şifre (en az 12 karakter)" />
                        </Border>
                        <!-- Kurtarma kodu tek kullanımlık: tekrar uyuşmazsa istek gönderilmez, kod harcanmaz. -->
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding KurtarmaYeniSifreTekrar}" Placeholder="Yeni şifre (tekrar)"
                                   IsPassword="{Binding KurtarmaSifresiniGoster, Converter={StaticResource TersIse}}"
                                   SemanticProperties.Description="Yeni şifre (tekrar)" />
                        </Border>
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox IsChecked="{Binding KurtarmaSifresiniGoster}" SemanticProperties.Description="Yeni şifreyi göster" />
                            <Label Text="Yeni şifreyi göster" Style="{StaticResource LblPageSub}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Button Text="Şifreyi yenile" Command="{Binding SifreKurtarCommand}" IsEnabled="{Binding Mesgul, Converter={StaticResource TersIse}}" />
                    </VerticalStackLayout>
                    <Label Text="{Binding KurtarmaMesaji}" TextColor="{StaticResource Green}" Margin="0,10,0,0" />
                    <!-- Kendi şifre değişikliğinden sonra: hata değil bilgi. -->
                    <Label Text="{Binding Bilgi}" TextColor="{StaticResource Green}" Margin="0,10,0,0"
                           IsVisible="{Binding Bilgi, Converter={StaticResource DoluIse}}" />
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,12,0,0"
                                           IsVisible="{Binding Mesgul}">
                        <ActivityIndicator IsRunning="{Binding Mesgul}" WidthRequest="16" HeightRequest="16" />
                        <Label Text="Giriş yapılıyor…" Style="{StaticResource LblRowSecondary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Alıcılar kendilerine verilen hesapla giriş yapar. İzleyici girişi için kullanıcı adını boş bırakın."
                   Style="{StaticResource LblRowSecondary}" FontSize="12"
                   HorizontalTextAlignment="Center" Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
