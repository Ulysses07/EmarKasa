<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · AylikPage — yıl+ay başlığı, kanal bazlı ay sonucu. -->
<ContentPage
    x:Class="Kasa.App.Views.AylikPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:Kasa.App.Controls"
    xmlns:core="clr-namespace:Kasa.App.Core;assembly=Kasa.App.Core"
    xmlns:api="clr-namespace:Kasa.ApiClient;assembly=Kasa.ApiClient"
    x:DataType="core:AylikViewModel"
    x:Name="Sayfa"
    Title="Aylık"
    BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout x:Name="AylikAlani" Padding="{OnIdiom Desktop='28,22', Default='16,14'}" Spacing="20"
                             MaximumWidthRequest="1160">
            <VerticalStackLayout Spacing="3">
                <Label Text="Aylık" Style="{StaticResource LblPageTitle}" />
                <Label Text="Kanal bazlı ay sonucu" Style="{StaticResource LblPageSub}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button Text="‹" Command="{Binding OncekiAyCommand}" Style="{StaticResource BtnSecondary}"
                        WidthRequest="44" Padding="0" FontSize="20" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="{Binding Ay, Converter={StaticResource AyAdi}}" FontAttributes="Bold" FontSize="20"
                           TextColor="{StaticResource Ink}" />
                    <Label Text="{Binding Yil}" FontAttributes="Bold" FontSize="20"
                           TextColor="{StaticResource Muted}" />
                </HorizontalStackLayout>
                <Button Grid.Column="2" Text="›" Command="{Binding SonrakiAyCommand}" Style="{StaticResource BtnSecondary}"
                        WidthRequest="44" Padding="0" FontSize="20" VerticalOptions="Center" />
            </Grid>

            <ctl:DurumSeridi Mesgul="{Binding Mesgul}" Hata="{Binding Hata}"
                             SonGuncellemeMetni="{Binding SonGuncellemeMetni}" YenileCommand="{Binding YenileCommand}" />

            <Border Style="{StaticResource Card}" IsVisible="{Binding VeriVar}">
                <!-- Son yükleme hata verdiyse son başarılı veri soluk gösterilir (tasarım 2026-10-02 §3; HD-01). -->
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding VeriEski}" Value="True">
                        <Setter Property="Opacity" Value="0.55" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="0">
                    <!-- K4: kapatılmış ay, kapatıldığı andaki raporla gösterilir. -->
                    <Border BackgroundColor="{StaticResource KilitZemin}" StrokeThickness="0" Padding="18,12" IsVisible="{Binding Dondurulmus}">
                        <Label Text="{Binding DondurulmusMetni}" TextColor="{StaticResource KilitMetin}" />
                    </Border>
                    <!-- K1: tutarları değiştirmeyen veri sağlığı uyarısı (takip başlangıcından önce tarihli giderler). -->
                    <Border BackgroundColor="{StaticResource UyariZemin}" StrokeThickness="0" Padding="18,12" IsVisible="{Binding VeriSagligiUyarisiVar}">
                        <Label Text="{Binding VeriSagligiUyarisi}" TextColor="{StaticResource UyariMetin}" />
                    </Border>
                    <Border BackgroundColor="{StaticResource UyariZemin}" StrokeThickness="0" Padding="18,12" IsVisible="{Binding DagilimBekliyor}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Dağılım bekliyor — kanal sonuçlarına henüz eklenmedi" TextColor="{StaticResource UyariMetin}" FontAttributes="Bold" />
                            <Label Text="{Binding Rapor.DagilimBekleyenTutar, Converter={StaticResource ParaBicim}}" TextColor="{StaticResource UyariMetin}" />
                        </VerticalStackLayout>
                    </Border>
                    <Grid Padding="18,16,18,12" ColumnDefinitions="*,Auto">
                        <Label Text="KANAL" Style="{StaticResource LblSection}" />
                        <Label Grid.Column="1" Text="{Binding AySonucuBasligi}" Style="{StaticResource LblSection}" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding Rapor.Kanallar}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="api:KanalAylikDto">
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <Grid Padding="18,0" HeightRequest="54"
                                          ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource AvatarChip}" VerticalOptions="Center">
                                            <Label Text="{Binding Kanal, Converter={StaticResource BasHarf}}"
                                                   Style="{StaticResource LblAvatar}" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding Kanal}"
                                               Style="{StaticResource LblRowPrimary}" VerticalOptions="Center" />
                                        <Label Grid.Column="2"
                                               Text="{Binding AySonucu, Converter={StaticResource ParaBicim}}"
                                               Style="{StaticResource LblMoney}"
                                               TextColor="{Binding AySonucu, Converter={StaticResource ParaRenk}}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <ctl:BosDurum Baslik="Bu ay için kayıt yok"
                                          Aciklama="İşlem girdikçe ay sonucu burada oluşur." />
                        </CollectionView.EmptyView>
                    </CollectionView>
                    <Grid Padding="18,12" ColumnDefinitions="*,Auto" IsVisible="{Binding GenelGiderVar}">
                        <Label Text="Yalnız genel kasa gideri (kanallara dağıtılmaz)" />
                        <Label Grid.Column="1" Text="{Binding Rapor.GenelGider, Converter={StaticResource ParaBicim}}" />
                    </Grid>
                    <Grid Padding="18,12" ColumnDefinitions="*,Auto" IsVisible="{Binding GenelGelirVar}">
                        <Label Text="Yalnız genel kasa geliri (kanallara dağıtılmaz)" />
                        <Label Grid.Column="1" Text="{Binding Rapor.GenelGelir, Converter={StaticResource ParaBicim}}" />
                    </Grid>
                    <!-- K2: kredi girişi kasaya (takipli kredide kanal kasasına da) girer; ay sonucuna dahil değildir. -->
                    <Grid Padding="18,12" ColumnDefinitions="*,Auto" IsVisible="{Binding KrediGirisiVar}">
                        <Label Text="Kredi girişi (kasaya girer, ay sonucuna dahil değil)" />
                        <Label Grid.Column="1" Text="{Binding KrediGirisiToplam, Converter={StaticResource ParaBicim}}" />
                    </Grid>
                    <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                        <Label Text="Genel ay sonucu" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding GenelAySonucu, Converter={StaticResource ParaBicim}}" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
