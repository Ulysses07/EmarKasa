<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · CarilerPage — üstte editör formu, altta cari listesi. -->
<ContentPage
    x:Class="Kasa.App.Views.CarilerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Sayfa"
    Title="Cariler"
    BackgroundColor="{StaticResource AppBg}">

    <Grid><!-- paket C · 32: "Silindi · Geri al" şeridi içeriğin üstünde, altta yüzer -->
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Desktop='28,22', Default='16,14'}" Spacing="20"
                             MaximumWidthRequest="1160">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Cariler" Style="{StaticResource LblPageTitle}" />
                    <Label Text="Cari hesap kartoteği" Style="{StaticResource LblPageSub}" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding Mesgul}" IsVisible="{Binding Mesgul}"
                                   WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
            </Grid>

            <!-- Hata (tüm roller) -->
            <Border Style="{StaticResource ErrorBox}" IsVisible="{Binding Hata, Converter={StaticResource DoluIse}}">
                <Label Text="{Binding Hata}" Style="{StaticResource LblError}" />
            </Border>

            <!-- Editör formu -->
            <Border Style="{StaticResource CardForm}" IsVisible="{Binding EditorMu}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Yeni / Düzenlenen Cari" Style="{StaticResource LblSection}" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Cari adı" Style="{StaticResource LblField}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding DuzenAd}" Placeholder="Örn. Yılmaz Gıda" />
                            </Border>
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="9" VerticalOptions="End"
                                               HeightRequest="44">
                            <Switch IsToggled="{Binding DuzenAktif}" VerticalOptions="Center" />
                            <Label Text="Aktif" Style="{StaticResource LblRowPrimary}" FontSize="13"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Button Grid.Column="2" Text="Kaydet" Command="{Binding KaydetCommand}"
                                VerticalOptions="End" />
                        <Button Grid.Column="3" Text="Yeni" Command="{Binding YeniCommand}"
                                Style="{StaticResource BtnSecondary}" VerticalOptions="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Cari listesi -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,260" ColumnSpacing="12" Padding="18,12,18,12">
                        <Label Text="Cari Listesi" Style="{StaticResource LblSection}" VerticalOptions="Center" />
                        <!-- Arama: yazarken kısa beklemeyle, Enter'da hemen -->
                        <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                            <Entry Text="{Binding Ara}" Placeholder="Cari ara…"
                                   ReturnCommand="{Binding AraCommand}" ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </Grid>
                    <CollectionView ItemsSource="{Binding Cariler}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <Grid Padding="18,0" HeightRequest="54"
                                          ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource AvatarChip}" VerticalOptions="Center">
                                            <Label Text="{Binding Ad, Converter={StaticResource BasHarf}}"
                                                   Style="{StaticResource LblAvatar}" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding Ad}"
                                               Style="{StaticResource LblRowPrimary}" VerticalOptions="Center" />
                                        <!-- Aktif/Pasif rozeti -->
                                        <Border Grid.Column="2" Style="{StaticResource StatusChip}"
                                                VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Aktif}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushGreenSoft}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Aktif}" Value="False">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{StaticResource ChipBg}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Style="{StaticResource LblStatusChip}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Aktif}" Value="True">
                                                        <Setter Property="Text" Value="Aktif" />
                                                        <Setter Property="TextColor" Value="{StaticResource Pos}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Aktif}" Value="False">
                                                        <Setter Property="Text" Value="Pasif" />
                                                        <Setter Property="TextColor" Value="{StaticResource Sub}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                        <!-- Satır aksiyonu (yalnız editör) -->
                                        <HorizontalStackLayout Grid.Column="4" Spacing="6" VerticalOptions="Center"
                                                               IsVisible="{Binding BindingContext.EditorMu, Source={x:Reference Sayfa}}">
                                            <Button Text="Düzenle" Style="{StaticResource BtnRowEdit}"
                                                    Command="{Binding BindingContext.DuzenleCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            <!-- Paket C · 32: işlemi olan cari sunucuda reddedilir (pasif yapılması önerilir) -->
                                            <Button Style="{StaticResource BtnRowDelete}"
                                                    Command="{Binding BindingContext.OnayliSilCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}">
                                                <Button.Text>
                                                    <MultiBinding Converter="{StaticResource SilDugmeMetni}">
                                                        <Binding Path="." />
                                                        <Binding Path="BindingContext.Silme.Bekleyen" Source="{x:Reference Sayfa}" />
                                                        <Binding Path="BindingContext.Silme.OnayDugmesi" Source="{x:Reference Sayfa}" />
                                                    </MultiBinding>
                                                </Button.Text>
                                            </Button>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,36,20,40" Spacing="6">
                                <Border Style="{StaticResource AvatarChip}" WidthRequest="40" HeightRequest="40"
                                        StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                    <Label Text="₺" Style="{StaticResource LblAvatar}" FontSize="17" />
                                </Border>
                                <Label Text="Cari kaydı yok" Style="{StaticResource LblEmptyTitle}" Margin="0,4,0,0" />
                                <Label Text="İlk cari kaydıyla liste burada oluşur."
                                       Style="{StaticResource LblEmptySub}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    <v:SilmeSeridi xmlns:v="clr-namespace:Kasa.App.Views" />
    </Grid>
</ContentPage>
