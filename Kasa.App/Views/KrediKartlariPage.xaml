<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · KrediKartlariPage — üstte editör formu, altta kart ızgarası. -->
<ContentPage
    x:Class="Kasa.App.Views.KrediKartlariPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Sayfa"
    Title="Kredi Kartları"
    BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Desktop='28,22', Default='16,14'}" Spacing="20"
                             MaximumWidthRequest="1160">
            <VerticalStackLayout Spacing="3">
                <Label Text="Kredi Kartları" Style="{StaticResource LblPageTitle}" />
                <Label Text="Limit, borç ve kalan limit takibi" Style="{StaticResource LblPageSub}" />
            </VerticalStackLayout>

            <!-- Editör formu -->
            <Border Style="{StaticResource CardForm}" IsVisible="{Binding EditorMu}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Yeni / Düzenlenen Kart" Style="{StaticResource LblSection}" />
                    <Grid ColumnDefinitions="{OnIdiom Desktop='1.4*,*,*,*,*', Default='*'}"
                          RowDefinitions="{OnIdiom Desktop='Auto', Default='Auto,Auto,Auto,Auto,Auto'}"
                          ColumnSpacing="10" RowSpacing="12">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Kart adı" Style="{StaticResource LblField}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding DuzenAd}" Placeholder="Örn. İş Bankası Maximum" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="{OnIdiom Desktop=1, Default=0}"
                                             Grid.Row="{OnIdiom Desktop=0, Default=1}" Spacing="0">
                            <Label Text="Kesim tarihi" Style="{StaticResource LblField}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <DatePicker Date="{Binding DuzenKesim}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="{OnIdiom Desktop=2, Default=0}"
                                             Grid.Row="{OnIdiom Desktop=0, Default=2}" Spacing="0">
                            <Label Text="Son ödeme tarihi" Style="{StaticResource LblField}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <DatePicker Date="{Binding DuzenSonOdeme}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="{OnIdiom Desktop=3, Default=0}"
                                             Grid.Row="{OnIdiom Desktop=0, Default=3}" Spacing="0">
                            <Label Text="Limit" Style="{StaticResource LblField}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding DuzenLimit, Converter={StaticResource ParaGiris}}" Placeholder="0,00 ₺"
                                       Style="{StaticResource EntryMoney}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="{OnIdiom Desktop=4, Default=0}"
                                             Grid.Row="{OnIdiom Desktop=0, Default=4}" Spacing="0">
                            <Label Text="Açılış borcu" Style="{StaticResource LblField}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding DuzenBorc, Converter={StaticResource ParaGiris}}" Placeholder="0,00 ₺"
                                       Style="{StaticResource EntryMoney}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Kaydet" Command="{Binding KaydetCommand}" Padding="22,0" />
                        <Button Text="Yeni" Command="{Binding YeniCommand}"
                                Style="{StaticResource BtnSecondary}" />
                    </HorizontalStackLayout>
                    <Border Style="{StaticResource ErrorBox}"
                            IsVisible="{Binding Hata, Converter={StaticResource DoluIse}}">
                        <Label Text="{Binding Hata}" Style="{StaticResource LblError}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Kart ızgarası -->
            <CollectionView ItemsSource="{Binding Kartlar}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=1, Default=3}"
                                     VerticalItemSpacing="16" HorizontalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <VerticalStackLayout Spacing="0">
                                <!-- Kart adı + mini kart grafiği -->
                                <HorizontalStackLayout Spacing="9">
                                    <Border WidthRequest="30" HeightRequest="21" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 5" Background="{StaticResource BrushGreen}"
                                            VerticalOptions="Center">
                                        <Border WidthRequest="8" HeightRequest="6" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 2" HorizontalOptions="Start"
                                                VerticalOptions="Center" Margin="5,0,0,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{StaticResource SidebarAccent}" />
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <Label Text="{Binding Ad}" FontFamily="PlexSansSemiBold" FontSize="15"
                                           TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <!-- Kesim / son ödeme -->
                                <Label Style="{StaticResource LblRowSecondary}" FontSize="12" Margin="0,4,0,14">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Kesim " />
                                            <Span Text="{Binding KesimTarihi, StringFormat='{0:dd MMM}'}" />
                                            <Span Text=" · Son ödeme " />
                                            <Span Text="{Binding SonOdemeTarihi, StringFormat='{0:dd MMM}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <!-- Limit -->
                                <BoxView Style="{StaticResource RowSeparator}" />
                                <Grid ColumnDefinitions="*,Auto" Padding="0,7">
                                    <Label Text="Limit" Style="{StaticResource LblPageSub}" FontSize="13" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Limit, Converter={StaticResource ParaBicim}}"
                                           Style="{StaticResource LblMoney}" FontSize="13.5" />
                                </Grid>
                                <!-- Güncel borç (türetilmiş) + kırılım -->
                                <BoxView Style="{StaticResource RowSeparator}" />
                                <Grid ColumnDefinitions="*,Auto" Padding="0,7,0,2">
                                    <Label Text="Güncel borç" Style="{StaticResource LblPageSub}" FontSize="13" />
                                    <Label Grid.Column="1"
                                           Text="{Binding GuncelBorc, Converter={StaticResource ParaBicim}}"
                                           Style="{StaticResource LblMoneyNeg}" FontSize="13.5" />
                                </Grid>
                                <Label Text="{Binding BorcKirilim}" Style="{StaticResource LblRowSecondary}"
                                       FontSize="11" Margin="0,0,0,5" />
                                <!-- Kalan limit barı -->
                                <ProgressBar Progress="{Binding KalanOran}"
                                             ProgressColor="{StaticResource Pos}" Margin="0,12,0,8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Kalan limit" Style="{StaticResource LblField}" Margin="0"
                                           VerticalOptions="End" />
                                    <Label Grid.Column="1"
                                           Text="{Binding KalanLimit, Converter={StaticResource ParaBicim}}"
                                           FontFamily="PlexSansBold" FontSize="17"
                                           TextColor="{StaticResource Pos}" />
                                </Grid>
                                <!-- Aksiyonlar (yalnız editör) -->
                                <VerticalStackLayout Spacing="0" Margin="0,14,0,0"
                                                     IsVisible="{Binding BindingContext.EditorMu, Source={x:Reference Sayfa}}">
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <HorizontalStackLayout Spacing="6" Margin="0,12,0,0">
                                        <Button Text="Düzenle" Style="{StaticResource BtnRowEdit}"
                                                Command="{Binding BindingContext.DuzenleCommand, Source={x:Reference Sayfa}}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Sil" Style="{StaticResource BtnRowDelete}"
                                                Command="{Binding BindingContext.SilCommand, Source={x:Reference Sayfa}}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>

                                    <!-- Ödeme ekle -->
                                    <Label Text="Ödeme ekle" Style="{StaticResource LblField}" Margin="0,14,0,4" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                        <Border Style="{StaticResource FieldBorder}">
                                            <DatePicker Date="{Binding OdemeTarihGiris}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                                            <Entry Text="{Binding OdemeTutarGiris, Converter={StaticResource ParaGiris}}"
                                                   Placeholder="0,00 ₺" Style="{StaticResource EntryMoney}" />
                                        </Border>
                                        <Button Grid.Column="2" Text="Ekle" Style="{StaticResource BtnRowEdit}"
                                                Command="{Binding BindingContext.OdemeEkleCommand, Source={x:Reference Sayfa}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                    <!-- Ödeme geçmişi -->
                                    <VerticalStackLayout Spacing="0" Margin="0,8,0,0"
                                                         BindableLayout.ItemsSource="{Binding Odemeler}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,4">
                                                    <Label Text="{Binding Tarih, StringFormat='{0:dd MMM}'}"
                                                           Style="{StaticResource LblRowSecondary}" FontSize="12"
                                                           VerticalOptions="Center" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Tutar, Converter={StaticResource ParaBicim}}"
                                                           Style="{StaticResource LblRowSecondary}" FontSize="12"
                                                           VerticalOptions="Center" />
                                                    <Button Grid.Column="2" Text="Sil" Style="{StaticResource BtnRowDelete}"
                                                            Command="{Binding BindingContext.OdemeSilCommand, Source={x:Reference Sayfa}}"
                                                            CommandParameter="{Binding .}" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Padding="20,36,20,40" Spacing="6">
                            <Border Style="{StaticResource AvatarChip}" WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                <Label Text="₺" Style="{StaticResource LblAvatar}" FontSize="17" />
                            </Border>
                            <Label Text="Kayıtlı kart yok" Style="{StaticResource LblEmptyTitle}" Margin="0,4,0,0" />
                            <Label Text="İlk kartla liste burada oluşur." Style="{StaticResource LblEmptySub}" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
