<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · KasaSayimiPage — solda editör sayım formu (defter değeri + canlı fark), sağda sayım geçmişi. -->
<ContentPage
    x:Class="Kasa.App.Views.KasaSayimiPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Sayfa"
    Title="Kasa Sayımı"
    BackgroundColor="{StaticResource AppBg}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="{OnIdiom Desktop='28,22', Default='16,14'}"
          RowSpacing="16" MaximumWidthRequest="1160">

        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="3">
                <Label Text="Kasa Sayımı" Style="{StaticResource LblPageTitle}" />
                <Label Text="Sayılan nakit ile defterdeki kasanın karşılaştırması" Style="{StaticResource LblPageSub}" />
                <Label Text="{Binding AktarilanDosya, StringFormat='Kaydedildi: {0}'}" Style="{StaticResource LblRowSecondary}"
                       TextColor="{StaticResource Pos}" LineBreakMode="CharacterWrap"
                       IsVisible="{Binding AktarilanDosya, Converter={StaticResource DoluIse}}" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding Mesgul}" IsVisible="{Binding Mesgul}"
                               WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
            <!-- Paket B · tüm sayımlar; Belgeler\Emar Kasa'ya kaydedilir ve açılır -->
            <Button Grid.Column="2" Text="Excel'e aktar" Command="{Binding ExceleAktarCommand}"
                    Style="{StaticResource BtnSecondary}" VerticalOptions="Center" />
        </Grid>

        <!-- Hata (tüm roller) -->
        <Border Grid.Row="1" Style="{StaticResource ErrorBox}"
                IsVisible="{Binding Hata, Converter={StaticResource DoluIse}}">
            <Label Text="{Binding Hata}" Style="{StaticResource LblError}" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="20">

            <!-- SOL: sayım formu (yalnız editör) -->
            <ScrollView IsVisible="{Binding EditorMu}" VerticalOptions="Fill">
                <VerticalStackLayout WidthRequest="360" Spacing="16">
                    <Border Style="{StaticResource CardForm}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Yeni Sayım" Style="{StaticResource LblSection}" />
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Tarih" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <DatePicker Date="{Binding FormTarih}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Defterdeki kasa (gün sonu)" Style="{StaticResource LblField}" />
                                <Label Text="{Binding DefterYazi}" Style="{StaticResource LblMoney}"
                                       HorizontalTextAlignment="Start" FontSize="18" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Sayılan tutar" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding SayilanTutar, Converter={StaticResource ParaGiris}}" Placeholder="0,00 ₺"
                                           Style="{StaticResource EntryMoney}" IsReadOnly="{Binding SatirlarKullaniliyor}" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- ==================== Paket D: satırlı sayım (nakit + küpür, bankalar, POS) ==================== -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Sayım satırları (doldurulursa sayılan tutar satırların toplamıdır)"
                                       Style="{StaticResource LblField}" Margin="0" />
                                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding SayimSatirlari}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="4">
                                                <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="6">
                                                    <Border Style="{StaticResource FieldBorder}">
                                                        <Entry Text="{Binding Ad}" Placeholder="{Binding TurAdi}" />
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                                                        <Entry Text="{Binding Tutar, Converter={StaticResource ParaGiris}}" Placeholder="0,00 ₺"
                                                               Style="{StaticResource EntryMoney}" IsReadOnly="{Binding KupurKullaniliyor}" />
                                                    </Border>
                                                    <Button Grid.Column="2" Text="Çıkar" Style="{StaticResource BtnRowDelete}"
                                                            Command="{Binding BindingContext.SatirSilCommand, Source={x:Reference Sayfa}}"
                                                            CommandParameter="{Binding .}" />
                                                </Grid>
                                                <!-- Nakit: isteğe bağlı küpür sayacı -->
                                                <Button Text="{Binding KupurOzeti}" Style="{StaticResource BtnRowEdit}" HorizontalOptions="Start"
                                                        IsVisible="{Binding NakitMi}"
                                                        Command="{Binding BindingContext.KupurAcKapatCommand, Source={x:Reference Sayfa}}"
                                                        CommandParameter="{Binding .}" />
                                                <FlexLayout Wrap="Wrap" AlignItems="Center" IsVisible="{Binding KupurAcik}"
                                                            BindableLayout.ItemsSource="{Binding Kupurler}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <VerticalStackLayout Spacing="0" WidthRequest="76" Margin="0,0,6,6">
                                                                <Label Text="{Binding Ad}" Style="{StaticResource LblField}" Margin="0,0,0,2" />
                                                                <Border Style="{StaticResource FieldBorder}">
                                                                    <Entry Text="{Binding Adet}" Keyboard="Numeric" Placeholder="0" />
                                                                </Border>
                                                            </VerticalStackLayout>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </FlexLayout>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <FlexLayout Wrap="Wrap" AlignItems="Center">
                                    <Button Text="+ Banka" Style="{StaticResource BtnRowEdit}" Margin="0,0,6,6"
                                            Command="{Binding SatirEkleCommand}" CommandParameter="Banka" />
                                    <Button Text="+ POS" Style="{StaticResource BtnRowEdit}" Margin="0,0,6,6"
                                            Command="{Binding SatirEkleCommand}" CommandParameter="Pos" />
                                    <Button Text="+ Nakit" Style="{StaticResource BtnRowEdit}" Margin="0,0,6,6"
                                            Command="{Binding SatirEkleCommand}" CommandParameter="Nakit" />
                                    <Button Text="+ Diğer" Style="{StaticResource BtnRowEdit}" Margin="0,0,6,6"
                                            Command="{Binding SatirEkleCommand}" CommandParameter="Diger" />
                                </FlexLayout>
                                <Label Text="{Binding SatirToplamiYazi, StringFormat='Satırların toplamı: {0} ₺'}"
                                       Style="{StaticResource LblRowSecondary}" IsVisible="{Binding SatirlarKullaniliyor}" />
                            </VerticalStackLayout>
                            <!-- ==================== /Paket D ==================== -->
                            <!-- Fark (sayılan − defter): 0 ise yeşil, fazla ya da eksikse kırmızı -->
                            <VerticalStackLayout Spacing="2" IsVisible="{Binding FarkGorunur}">
                                <Label Text="Fark (sayılan − defter)" Style="{StaticResource LblField}" />
                                <Label Text="{Binding FarkYazi}" Style="{StaticResource LblMoney}"
                                       HorizontalTextAlignment="Start" FontSize="18"
                                       TextColor="{Binding FarkRenkDegeri, Converter={StaticResource ParaRenk}}" />
                                <Label Text="{Binding FarkMetni}" Style="{StaticResource LblRowSecondary}"
                                       TextColor="{Binding FarkRenkDegeri, Converter={StaticResource ParaRenk}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Not" Style="{StaticResource LblField}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding Not}" Placeholder="İsteğe bağlı" />
                                </Border>
                            </VerticalStackLayout>
                            <Button Text="Sayımı kaydet" Command="{Binding KaydetCommand}" Margin="0,2,0,0" />
                            <Label Text="Sayım hiçbir kasa rakamını değiştirmez; yalnız karşılaştırma kaydı tutar."
                                   Style="{StaticResource LblRowSecondary}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                    <v:SilmeSeridi xmlns:v="clr-namespace:Kasa.App.Views" HorizontalOptions="Fill" Margin="0" /><!-- paket C · 32: Silindi · Geri al (form sütununda, liste kaymaz) -->
                </VerticalStackLayout>
            </ScrollView>

            <!-- SAĞ: sayım geçmişi (her iki rol) -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid RowDefinitions="Auto,*">
                    <Label Text="Sayım Geçmişi" Style="{StaticResource LblSection}" Margin="18,16,18,12" />
                    <CollectionView Grid.Row="1" ItemsSource="{Binding Sayimlar}" SelectionMode="None">
                        <!-- ==================== Paket D: son sayım hatırlatması ve ay ay açıklanmamış fark ==================== -->
                        <CollectionView.Header>
                            <VerticalStackLayout Padding="18,0,18,12" Spacing="8">
                                <Label Text="{Binding SonSayimMetni}" Style="{StaticResource LblRowSecondary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SayimGecikti}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Neg}" />
                                            <Setter Property="FontFamily" Value="PlexSansSemiBold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding AylikFarkVar}">
                                    <Label Text="Ay ay açıklanmamış fark" Style="{StaticResource LblField}" Margin="0" />
                                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding AylikFarklar}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10">
                                                    <Label Text="{Binding AyAdi}" Style="{StaticResource LblRowSecondary}" FontSize="12"
                                                           VerticalOptions="Center" />
                                                    <ProgressBar Grid.Column="1" Progress="{Binding Oran}" ProgressColor="{StaticResource Neg}"
                                                                 VerticalOptions="Center" />
                                                    <Label Grid.Column="2" Text="{Binding Metin}" Style="{StaticResource LblRowSecondary}" FontSize="12"
                                                           TextColor="{Binding RenkDegeri, Converter={StaticResource ParaRenk}}"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </CollectionView.Header>
                        <!-- ==================== /Paket D ==================== -->
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <Grid Padding="18,8" MinimumHeightRequest="58"
                                          ColumnDefinitions="Auto,*,120,120,110,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource DateChip}" WidthRequest="84" VerticalOptions="Center">
                                            <Label Text="{Binding Tarih, StringFormat='{0:dd.MM.yyyy}'}"
                                                   Style="{StaticResource LblDateChip}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Not}" Style="{StaticResource LblRowPrimary}"
                                                   IsVisible="{Binding NotVar}" />
                                            <Label Text="{Binding FarkMetni}" Style="{StaticResource LblRowSecondary}" />
                                            <!-- Sayımdan sonra o güne kadarki kayıtlar değiştiyse -->
                                            <Label Text="{Binding DefterDegistiMetni}" Style="{StaticResource LblRowSecondary}"
                                                   TextColor="{StaticResource Neg}"
                                                   IsVisible="{Binding DefterDegistiMetni, Converter={StaticResource DoluIse}}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Sayılan" Style="{StaticResource LblRowSecondary}" FontSize="11"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text="{Binding SayilanTutar, Converter={StaticResource ParaBicim}}"
                                                   Style="{StaticResource LblMoney}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="3" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Defter" Style="{StaticResource LblRowSecondary}" FontSize="11"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text="{Binding HesaplananTutar, Converter={StaticResource ParaBicim}}"
                                                   Style="{StaticResource LblMoney}" TextColor="{StaticResource Sub}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="4" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Fark" Style="{StaticResource LblRowSecondary}" FontSize="11"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text="{Binding FarkYazi}" Style="{StaticResource LblMoney}"
                                                   TextColor="{Binding FarkRenkDegeri, Converter={StaticResource ParaRenk}}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="5" Style="{StaticResource BtnRowDelete}"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding BindingContext.EditorMu, Source={x:Reference Sayfa}}"
                                                Command="{Binding BindingContext.OnayliSilCommand, Source={x:Reference Sayfa}}"
                                                CommandParameter="{Binding .}">
                                            <Button.Text>
                                                <MultiBinding Converter="{StaticResource SilDugmeMetni}">
                                                    <Binding Path="." />
                                                    <Binding Path="BindingContext.Silme.Bekleyen" Source="{x:Reference Sayfa}" />
                                                    <Binding Path="BindingContext.Silme.OnayDugmesi" Source="{x:Reference Sayfa}" />
                                                </MultiBinding>
                                            </Button.Text>
                                        </Button>
                                    </Grid>

                                    <!-- ==================== Paket D: satırlar, fark durumu, "Neden değişti?" ==================== -->
                                    <VerticalStackLayout Padding="18,0,18,10" Spacing="6">
                                        <Label Text="{Binding SatirlarMetni}" Style="{StaticResource LblRowSecondary}" FontSize="12"
                                               LineBreakMode="WordWrap" IsVisible="{Binding SatirlarVar}" />
                                        <FlexLayout Wrap="Wrap" AlignItems="Center">
                                            <Label Text="{Binding FarkDurumMetni}" Style="{StaticResource LblRowSecondary}" FontSize="12"
                                                   FontFamily="PlexSansSemiBold" VerticalOptions="Center" Margin="0,0,10,4"
                                                   IsVisible="{Binding FarkVar}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding FarkAcik}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource Neg}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Button Text="Açıkla / kabul et" Style="{StaticResource BtnRowEdit}" Margin="0,0,6,4"
                                                    IsVisible="{Binding FarkVar}" IsEnabled="{Binding BindingContext.EditorMu, Source={x:Reference Sayfa}}"
                                                    Command="{Binding BindingContext.FarkFormuAcKapatCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Neden değişti?" Style="{StaticResource BtnRowEdit}" Margin="0,0,6,4"
                                                    Command="{Binding BindingContext.NedenDegistiCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                        </FlexLayout>
                                        <!-- Fark açıklama formu (yalnız editör) -->
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding FarkFormuAcik}">
                                            <Border Style="{StaticResource FieldBorder}">
                                                <Entry Text="{Binding AciklamaGiris}" Placeholder="Farkın nedeni" />
                                            </Border>
                                            <Button Grid.Column="1" Text="Açıklandı" Style="{StaticResource BtnRowEdit}"
                                                    Command="{Binding BindingContext.FarkAciklaCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Grid.Column="2" Text="Kabul et" Style="{StaticResource BtnRowEdit}"
                                                    Command="{Binding BindingContext.FarkKabulEtCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Grid.Column="3" Text="Açığa al" Style="{StaticResource BtnRowDelete}"
                                                    Command="{Binding BindingContext.FarkAcikYapCommand, Source={x:Reference Sayfa}}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                        <!-- Sayımdan sonra o günü etkileyen değişiklikler -->
                                        <VerticalStackLayout Spacing="4" IsVisible="{Binding NedenAcik}">
                                            <Label Text="{Binding NedenOzeti}" Style="{StaticResource LblRowSecondary}" FontSize="12"
                                                   LineBreakMode="WordWrap" />
                                            <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Nedenler}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <VerticalStackLayout Spacing="1">
                                                            <Label Text="{Binding Ozet}" Style="{StaticResource LblRowPrimary}" FontSize="12.5"
                                                                   LineBreakMode="WordWrap" />
                                                            <Label Text="{Binding Ayrinti}" Style="{StaticResource LblRowSecondary}" FontSize="11.5" />
                                                        </VerticalStackLayout>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                    <!-- ==================== /Paket D ==================== -->
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,36,20,40" Spacing="6">
                                <Border Style="{StaticResource AvatarChip}" WidthRequest="40" HeightRequest="40"
                                        StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                    <Label Text="₺" Style="{StaticResource LblAvatar}" FontSize="17" />
                                </Border>
                                <Label Text="Henüz sayım yok" Style="{StaticResource LblEmptyTitle}" Margin="0,4,0,0" />
                                <Label Text="Kasadaki nakdi sayıp girdikçe defterle karşılaştırmalar burada birikir."
                                       Style="{StaticResource LblEmptySub}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
