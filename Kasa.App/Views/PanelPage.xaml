<?xml version="1.0" encoding="UTF-8" ?>
<!-- Emar Kasa · PanelPage — genel kasa + kanal bakiyeleri. -->
<ContentPage
    x:Class="Kasa.App.Views.PanelPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctl="clr-namespace:Kasa.App.Controls"
    xmlns:core="clr-namespace:Kasa.App.Core;assembly=Kasa.App.Core"
    x:DataType="core:PanelViewModel"
    x:Name="Sayfa"
    Title="Kasalar"
    BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout x:Name="PanelAlani" Padding="{OnIdiom Desktop='28,22', Default='16,14'}" Spacing="20"
                             MaximumWidthRequest="1160">

            <VerticalStackLayout Spacing="3">
                <Label Text="Kasalar" Style="{StaticResource LblPageTitle}" />
                <Label Text="Kasa özeti ve kanal bakiyeleri" Style="{StaticResource LblPageSub}" />
            </VerticalStackLayout>

            <ctl:DurumSeridi Mesgul="{Binding Mesgul}" Hata="{Binding Hata}"
                             SonGuncellemeMetni="{Binding SonGuncellemeMetni}" YenileCommand="{Binding YenileCommand}" />

            <!-- Takipte olmayan kart ve krediler: hatırlatmaları eski kayıtlarla sınırlı; geçiş yapılana kadar kalıcı uyarı. -->
            <Border Style="{StaticResource CardForm}" IsVisible="{Binding TakipsizVar}">
                <!-- Uyarı da son başarılı yüklemeden kalır; eski veride panel kartları gibi soluk. -->
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding VeriEski}" Value="True">
                        <Setter Property="Opacity" Value="0.55" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="6">
                    <Label Text="GEÇİŞ BEKLEYEN KART VE KREDİLER" Style="{StaticResource LblSection}" />
                    <Label Text="{Binding TakipsizUyari}" Style="{StaticResource LblError}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardHero}" IsVisible="{Binding VeriVar}">
                <!-- Son yükleme hata verdiyse son başarılı veri soluk gösterilir (tasarım 2026-10-02 §3; HD-01). -->
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding VeriEski}" Value="True">
                        <Setter Property="Opacity" Value="0.55" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="0">
                    <Label Text="GENEL KASA" Style="{StaticResource LblHeroLabel}" />
                    <Label Text="{Binding GuncelKasa, Converter={StaticResource ParaBicim}}"
                           Style="{StaticResource LblHeroAmount}" Margin="0,8,0,0" />
                    <Label Text="Takip başlangıcı ve açılış devri dahil"
                           Style="{StaticResource LblHeroSub}" Margin="0,10,0,0" />
                    <VerticalStackLayout IsVisible="{Binding DagilimBekliyor}" Spacing="4" Margin="0,14,0,0">
                        <Label Text="Dağılım bekleyen alış ödemesi" TextColor="{StaticResource HeroUyari}" FontAttributes="Bold" />
                        <Label Text="{Binding DagilimBekleyenTutar, Converter={StaticResource ParaBicim}}" TextColor="{StaticResource HeroUyari}" FontSize="20" />
                        <Label Text="Kasa hareketi kayıtlı; bu tutar alış onaylanana kadar kanal bakiyelerine dağıtılmaz." TextColor="{StaticResource HeroUyari}" FontSize="12" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding VeriVar}">
                <!-- Son yükleme hata verdiyse son başarılı veri soluk gösterilir (tasarım 2026-10-02 §3; HD-01). -->
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding VeriEski}" Value="True">
                        <Setter Property="Opacity" Value="0.55" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="0">
                    <Label Text="KANAL BAKİYELERİ" Style="{StaticResource LblSection}" Margin="18,16,18,12" />
                    <CollectionView ItemsSource="{Binding Kanallar}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="core:KanalKasaSatiri">
                                <VerticalStackLayout>
                                    <BoxView Style="{StaticResource RowSeparator}" />
                                    <Grid Padding="18,8" MinimumHeightRequest="66"
                                          ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Style="{StaticResource AvatarChip}" VerticalOptions="Center">
                                            <Label Text="{Binding Kanal, Converter={StaticResource BasHarf}}"
                                                   Style="{StaticResource LblAvatar}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding Kanal}" Style="{StaticResource LblRowPrimary}" />
                                            <Label Text="{Binding KartBorcuMetni}" Style="{StaticResource LblPageSub}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding Bakiye, Converter={StaticResource ParaBicim}}"
                                               Style="{StaticResource LblMoney}"
                                               TextColor="{Binding Bakiye, Converter={StaticResource ParaRenk}}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <ctl:BosDurum Baslik="Henüz kanal yok"
                                          Aciklama="Ayarlar → Kanallar bölümünden ilk kanalınızı ekleyin." />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
