# Kasa Defteri üretim ortam değişkenleri.
# Bu dosyayı VPS'te `deploy/.env` olarak kopyala ve gerçek değerlerle doldur.
# .env ASLA repoya commit edilmez (aşağıdaki .gitignore adımına bak).

# JWT imzalama anahtarı — en az 32 karakter, rastgele. Üret:
#   openssl rand -base64 48
KASA_JWT_KEY=

# Editör (veri girişi yapan ortak) kullanıcı adı + şifresi.
KASA_EDITOR_KULLANICI=
KASA_EDITOR_SIFRE=

# Kalıcı veri (/data) ve otomatik yedek (/yedekler) için host dizinleri — ZORUNLU, mutlak yol.
# Compose bu değişkenler boşsa veya tanımsızsa bilerek durur; varsayılan dizin yoktur.
# deploy/ altındaki ./kasa-data 2.0 öncesinden korunmuş ESKİ veritabanıdır: KULLANMAYIN.
#
# Mevcut sunucuda etkin dizini şu iki kaynaktan bulun ve ikisinin aynı olduğunu doğrulayın:
#   1) Son yayın manifestinin dataDirectory alanı:
#        grep -o '"dataDirectory"[^,}]*' /opt/kasa/releases/<son-yayın>/<ad>-published.json
#   2) Çalışan konteynerin bağlamaları:
#        docker inspect kasa-app --format '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{println}}{{end}}'
#      /data satırının kaynağı KASA_DATA_DIR, /yedekler satırının kaynağı KASA_BACKUP_DIR olur.
# Yeni kurulumda dizinleri önce oluşturun (mkdir -p); yol yanlış yazılırsa Docker boş dizin
# açar ve uygulama boş veritabanıyla başlar.
# Örnek biçim (gerçek değeri yukarıdaki kaynaklardan alın, bu satırı kopyalamayın):
#   KASA_DATA_DIR=/opt/kasa/deploy/kasa-data-<yayın>-<damga>
#   KASA_BACKUP_DIR=/opt/kasa/deploy/<yedek-dizini>
KASA_DATA_DIR=
KASA_BACKUP_DIR=
