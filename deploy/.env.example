# Kasa Defteri üretim ortam değişkenleri.
# Bu dosyayı VPS'te `deploy/.env` olarak kopyala ve gerçek değerlerle doldur.
# .env ASLA repoya commit edilmez (aşağıdaki .gitignore adımına bak).

# JWT imzalama anahtarı — en az 32 karakter, rastgele. Üret:
#   openssl rand -base64 48
KASA_JWT_KEY=

# Editör (veri girişi yapan ortak) kullanıcı adı + şifresi.
# Bu şifre, editör uygulamadan (Ayarlar › Hesabım) yeni şifre verene kadar geçerlidir;
# sonra veritabanındaki şifre geçer, buradaki değer girişte kullanılmaz.
KASA_EDITOR_KULLANICI=
KASA_EDITOR_SIFRE=
# Editör şifresini unuttuysanız (ya da iki adımlı giriş telefonu kaybolduysa) bir kez true yapıp
# yeniden başlatın: uygulamadan verilen şifre, iki adımlı giriş ve kurtarma kodları silinir,
# yukarıdaki KASA_EDITOR_SIFRE yeniden geçerli olur. Girdikten sonra false yapıp yeniden başlatın
# (açık kalırsa her açılışta yeniden sıfırlar). Ayrıntı: deploy/README.md → "Kullanıcılar ve güvenlik".
KASA_EDITOR_SIFRESINI_SIFIRLA=false

# Güvenilir reverse proxy ağı (CIDR) — yalnız bu ağdan gelen X-Forwarded-For
# başlığına güvenilir (giriş hız sınırı gerçek istemci IP'siyle çalışsın diye).
# Caddy (orderdeck_web) kurulumu için değeri bul:
#   docker network inspect orderdeck_web -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Örnek: 172.18.0.0/16
KASA_GUVENILIR_AGLAR=

# ---- Sunucu dışı yedek (kasa-yedek servisi) — deploy/README.md → "Sunucu dışı yedek" ----
# Boş bırakılırsa sunucu dışı yedek kapalıdır (sunucudaki günlük yedek yine alınır).
# rclone hedefi: <rclone config'te verdiğiniz ad>:<klasör>. Örnek: uzak:kasa-yedek
KASA_UZAK_HEDEF=
# Şifreleme parolası: yedekler bu parolayla şifrelenip gönderilir. Uzun ve rastgele olsun:
#   openssl rand -base64 32
# PAROLAYI SUNUCU DIŞINDA DA SAKLAYIN (ör. parola yöneticisi / kasada kâğıt). Parola
# kaybolursa uzaktaki yedekler AÇILAMAZ. Sonradan değiştirmeyin: eski kopyalar eski parolayla kalır.
KASA_YEDEK_SIFRE=
# Her gece çalışma saati (Türkiye saati, SS:DD). Uygulamanın günlük yedeği gece yarısından
# sonraki ilk saat içinde alınır; bu saat ondan sonra olmalı. Varsayılan 03:30.
KASA_UZAK_SAAT=03:30
# Haftalık doğrulama günü: 1=Pazartesi … 7=Pazar. Varsayılan 7.
KASA_DOGRULAMA_GUNU=7
