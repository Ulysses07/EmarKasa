# Günlük sunucu dışı yedek. Uygulama otomatik yedeği saatlik denetimle ~24 saatte bir alır; gönderim her gün
# yeni dosyayı bulur. Persistent=true: sunucu o saatte kapalıysa açılışta çalışır.
[Unit]
Description=Kasa sunucu dışı yedek (günlük)

[Timer]
OnCalendar=*-*-* 04:30:00 Europe/Istanbul
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
