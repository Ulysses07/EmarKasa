# Kasa sunucu dışı yedek ayarları (deploy/uzak_yedek.py, deploy/systemd/kasa-uzak-*.service).
# Sunucuda /etc/kasa/uzak-yedek.env olarak kopyalanıp doldurulur; depodaki bu örnek BOŞ kalır:
#   sudo install -d -m 700 /etc/kasa
#   sudo install -m 600 /opt/kasa/deploy/uzak-yedek.env.example /etc/kasa/uzak-yedek.env
# Kimlik bilgisi bu dosyaya yazılmaz. Uzak deponun anahtarları ve şifreleme ('crypt') parolaları rclone.conf'tadır
# (/root/.config/rclone/rclone.conf, izin 600) ve VPS kaybında geri dönebilmek için parola yöneticisinde de saklanır.
# Boş bırakılan değer varsayılanı kullanır. Adımlar: docs/deploy/operasyon-runbook.md "Sunucu dışı yedek".

# Uzak hedef (ZORUNLU): rclone'da tanımlı 'crypt' uzağı ve klasör, ör. kasa-sifreli:yedekler
# Şifresiz uzak (s3, b2, sftp ...) reddedilir; bilerek şifresiz göndermek için KASA_UZAK_SIFRESIZ=evet.
KASA_UZAK_HEDEF=

# rclone (varsayılan) ya da dizin (bağlı bir diskteki dizin; şifreleme yapmaz, KASA_UZAK_SIFRESIZ=evet ister).
KASA_UZAK_YONTEM=
KASA_UZAK_SIFRESIZ=

# Hedefte saklama (varsayılan evet): otomatik yedeklerde son KASA_UZAK_GUNLUK_GUN günün hepsi (varsayılan 35) ve son
# KASA_UZAK_AYLIK_AY takvim ayının ilk yedeği (varsayılan 13), her durumda en yeni 7; elle yedeklerden en yeni 10.
# Göç öncesi yedekler hiç silinmez. Anahtarın silme yetkisi yoksa ve saklamayı depo kuralı yapıyorsa: hayir.
KASA_UZAK_SAKLAMA=
KASA_UZAK_GUNLUK_GUN=
KASA_UZAK_AYLIK_AY=
# Tek çalışmada hedefte silinebilecek en çok otomatik kopya (varsayılan 5; olağan çalışmada günde 1-2). Aşılırsa hiç
# silinmez ve hata bildirilir: sistem saati ileri kaymış olabilir. Kalıcı olarak yükseltmeyin; birikmiş silme için
# runbook "Saat hatası ve toplu silme sınırı" bölümündeki tek seferlik komutu kullanın.
KASA_UZAK_SILME_EN_FAZLA=

# İzleme ("ölü adam anahtarı", ör. healthchecks.io): başarıda adrese, hatada adres + /fail'e istek atılır.
# Adres gizli kimlik taşır; yalnız sunucudaki dosyaya yazılır. Gönderim (6 saatte bir) ve haftalık doğrulama ayrı iki denetim.
KASA_UZAK_IZLEME_URL=
KASA_UZAK_DOGRULA_IZLEME_URL=

# En yeni yerel otomatik yedek bu kadar saatten eskiyse hata (uygulamanın günlük yedeği durmuş). Varsayılan 48.
KASA_YEDEK_EN_FAZLA_SAAT=
# Yedek ve veri diski bu yüzdeye ulaşınca hata. Varsayılan 80.
KASA_DISK_ESIK_YUZDE=

# Yedek ve veri dizini boşsa /opt/kasa/deploy/.env'deki KASA_BACKUP_DIR ve KASA_DATA_DIR okunur (yalnız bu ikisi;
# oradaki sırlar okunmaz). Etkin dizin kuralı: deploy/README.md "Veri ve yedek dizini kuralı". Farklı .env yolu için
# KASA_DEPLOY_ENV. rclone başka yerdeyse KASA_RCLONE. rclone.conf varsayılan yerinde değilse RCLONE_CONFIG=<yol>
# satırını ekleyin; boş RCLONE_CONFIG rclone'u yapılandırmasız çalıştırır, bu yüzden örnekte yoktur.
KASA_BACKUP_DIR=
KASA_DATA_DIR=
KASA_DEPLOY_ENV=
KASA_RCLONE=
