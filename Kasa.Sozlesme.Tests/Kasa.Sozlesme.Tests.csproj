<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sözleşme testleri (contract-8 ve tests-8'in gerçek API yarısı; tests-8'in Kasa.ApiClient.Tests yarısı o projede
       kapandı: SahteHandler, MutasyonTests, FinansIyilestirmeTests): gerçek KasaApiClient, test sunucusundaki gerçek
       Kasa.Api'ye konuşur. Kök ad alanı Kasa.Sozlesme.Tests'tir:
       Kasa.Api altında olsaydı aynı adlı sunucu tipleri (Kasa.Api.PanelDto ...) using yönergelerinden önce çözülürdü.
       Kasa.Api.Tests'e başvurmaz; kendi fabrikası vardır. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kasa.Sozlesme.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kasa.Api\Kasa.Api.csproj" />
    <ProjectReference Include="..\Kasa.ApiClient\Kasa.ApiClient.csproj" />
    <!-- Yalnız MimariTests içindir: katman sınırı denetimi dört katmanın (Core, ApiClient, App.Core, Api) derlemesini
         birlikte görür. Kasa.App.Core net10.0 kütüphanesidir; MAUI ve iş yükü gerektirmez. -->
    <ProjectReference Include="..\Kasa.App.Core\Kasa.App.Core.csproj" />
  </ItemGroup>

</Project>
