<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Kasa.Core\Kasa.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <!-- NU1903 (GHSA-2m69-gcr7-jv3q): EF Sqlite'ın çektiği 2.1.11 yerine yamalıyı pinle. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- SPA emekli oldu. Statik web varlıkları (bundling/fingerprint) kapalı; wwwroot'ta yalnız
         telefon uygulaması (/m) var ve MobilWeb.cs onu doğrudan sunar. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Paket F: telefon uygulaması (wwwroot/m) derleme ve publish çıktısına kopyalanır
         (MobilWeb.KlasorBul içerik kökünde bulamazsa uygulama klasörüne bakar). -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
