<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Kasa.Core\Kasa.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- NU1903 (GHSA-2m69-gcr7-jv3q): EF Sqlite'ın çektiği 2.1.11 yerine yamalıyı pinle. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Sürümün tek kaynağı depo kökündeki Directory.Build.props (KasaSurumu); /api/surum onu bu derlemenin meta
         verisinden okur (SunucuSurumu). -->
    <Version>$(KasaSurumu)</Version>
  </PropertyGroup>

  <!-- Directory.Build.props derlemeye girmezse (ör. Dockerfile onu kopyalamazsa) Version boş kalır ve SDK 1.0.0 yazar:
       sunucu yanlış sürüm bildirmesin diye derleme durur. -->
  <Target Name="KasaSurumuDenetle" BeforeTargets="PrepareForBuild">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(KasaSurumu)', '^\d+\.\d+\.\d+$'))"
           Text="KasaSurumu tanımsız ya da üç parçalı değil ('$(KasaSurumu)'): depo kökündeki Directory.Build.props derlemeye girmeli." />
  </Target>

</Project>
