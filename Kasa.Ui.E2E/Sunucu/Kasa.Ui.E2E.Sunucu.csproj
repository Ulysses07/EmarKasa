<Project Sdk="Microsoft.NET.Sdk">

  <!-- Uçtan uca (Playwright) testlerinin Kasa.Api sunucusu. Kasa.Api değişmez: WebApplicationFactory onu gerçek Kestrel'de
       (yalnız 127.0.0.1) açar; tek fark sabit saattir (sayfalar ve tohum veri her gün aynı görünür). Çözüme (Kasa.slnx)
       eklenmez; playwright.config.mjs'teki webServer derleyip çalıştırır. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kasa.Ui.E2E.Sunucu</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Kasa.Api\Kasa.Api.csproj" />
  </ItemGroup>

</Project>
